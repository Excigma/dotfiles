index 0000000000000000000000000000000000000000..2978f20767695608e2376c4015b0e0f6e8fbb1c2
--- /dev/null
+++ b/src/tools/cursor/cursortool.cpp
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "cursortool.h"
+
+#include <QPainterPath>
+#include <QTransform>
+
+CursorTool::CursorTool(QObject* parent)
+  : AbstractTwoPointTool(parent)
+{
+    m_supportsDiagonalAdj = true;
+}
+
+QIcon CursorTool::icon(const QColor& background, bool inEditor) const
+{
+    Q_UNUSED(inEditor)
+    return QIcon(iconPath(background) + "mouse.svg");
+}
+
+QString CursorTool::name() const
+{
+    return tr("Cursor");
+}
+
+QString CursorTool::description() const
+{
+    return tr("Add a mock cursor to the capture");
+}
+
+QRect CursorTool::boundingRect() const
+{
+    return QRect(points().first, points().second).normalized().adjusted(
+      -size(), -size(), size(), size());
+}
+
+CaptureTool::Type CursorTool::type() const
+{
+    return CaptureTool::TYPE_CURSOR;
+}
+
+CaptureTool* CursorTool::copy(QObject* parent)
+{
+    auto* tool = new CursorTool(parent);
+    copyParams(this, tool);
+    return tool;
+}
+
+void CursorTool::paintCursor(QPainter& painter, const QRectF& bounds) const
+{
+    if (bounds.width() <= 0 || bounds.height() <= 0) {
+        return;
+    }
+
+    QPainterPath cursor;
+    cursor.moveTo(0.04, 0.02);
+    cursor.lineTo(0.05, 0.87);
+    cursor.lineTo(0.29, 0.66);
+    cursor.lineTo(0.49, 0.98);
+    cursor.lineTo(0.67, 0.86);
+    cursor.lineTo(0.48, 0.57);
+    cursor.lineTo(0.83, 0.53);
+    cursor.closeSubpath();
+
+    QTransform transform;
+    transform.translate(bounds.left(), bounds.top());
+    transform.scale(bounds.width(), bounds.height());
+
+    const QColor outline =
+      ColorUtils::colorIsDark(color()) ? Qt::white : Qt::black;
+    const qreal outlineWidth = qBound<qreal>(1.0, size(), 8.0);
+
+    painter.save();
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setPen(QPen(outline,
+                        outlineWidth,
+                        Qt::SolidLine,
+                        Qt::RoundCap,
+                        Qt::RoundJoin));
+    painter.setBrush(color());
+    painter.drawPath(transform.map(cursor));
+    painter.restore();
+}
+
+void CursorTool::process(QPainter& painter, const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    paintCursor(painter, QRect(points().first, points().second).normalized());
+}
+
+void CursorTool::drawSearchArea(QPainter& painter, const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    painter.fillRect(boundingRect(), Qt::black);
+}
+
+void CursorTool::paintMousePreview(QPainter& painter,
+                                   const CaptureContext& context)
+{
+    const QSize previewSize(18 + context.toolSize * 2,
+                            26 + context.toolSize * 2);
+    paintCursor(painter, QRectF(context.mousePos, previewSize));
+}
+
+QRect CursorTool::mousePreviewRect(const CaptureContext& context) const
+{
+    return QRect(context.mousePos,
+                 QSize(18 + context.toolSize * 2,
+                       26 + context.toolSize * 2))
+      .adjusted(-context.toolSize,
+                -context.toolSize,
+                context.toolSize,
+                context.toolSize);
+}
+
+void CursorTool::pressed(CaptureContext& context)
+{
+    Q_UNUSED(context)
+}
