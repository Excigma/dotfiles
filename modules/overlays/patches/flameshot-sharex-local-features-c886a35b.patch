+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#pragma once
+
+#include "secureredactionprocessor.h"
+#include "tools/abstracttwopointtool.h"
+
+/**
+ * Shared editable geometry and source-independent preview for secure covers.
+ *
+ * process() is deliberately only a preview. The original screenshot still
+ * exists while the initial rectangle is adjusted. Security begins only after
+ * the central confirmation boundary recognizes the CaptureTool redaction
+ * descriptor, uses SecureRedactionProcessor::apply(), replaces all backing
+ * screenshots with its fresh result, and discards preview/history copies
+ * containing original pixels.
+ */
+class SecureRectangleTool : public AbstractTwoPointTool
+{
+public:
+    explicit SecureRectangleTool(QObject* parent = nullptr);
+
+    bool isValid() const override;
+    QRect boundingRect() const override;
+
+    void process(QPainter& painter, const QPixmap& pixmap) final;
+    void drawSearchArea(QPainter& painter, const QPixmap& pixmap) final;
+    void paintMousePreview(QPainter& painter,
+                           const CaptureContext& context) final;
+
+public slots:
+    void pressed(CaptureContext& context) final;
+
+protected:
+    [[nodiscard]] SecureRedactionProcessor::Options coverOptions() const;
+};
diff --git a/src/tools/redaction/secureredactionprocessor.cpp b/src/tools/redaction/secureredactionprocessor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b64acc45db018e7c5ff7bf1781572aff46e99004
--- /dev/null
+++ b/src/tools/redaction/secureredactionprocessor.cpp
@@ -0,0 +1,389 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "secureredactionprocessor.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+namespace {
+
+constexpr int MAX_VARIATION = 96;
+constexpr int WEIGHT_SCALE = 65535;
+
+QColor opaqueColor(const QColor& requested)
+{
+    QColor result = requested.isValid() ? requested : QColor(36, 36, 36);
+    result.setAlpha(255);
+    return result;
+}
+
+quint32 mixCoordinates(quint32 x, quint32 y, quint32 seed)
+{
+    // A small integer mixer. It is deterministic visual patterning, not a
+    // cryptographic primitive and not part of the confidentiality boundary.
+    quint32 value = seed ^ (x * 0x9e3779b9u) ^ (y * 0x85ebca6bu);
+    value ^= value >> 16;
+    value *= 0x7feb352du;
+    value ^= value >> 15;
+    value *= 0x846ca68bu;
+    value ^= value >> 16;
+    return value;
+}
+
+int channelDelta(quint32 value, int variation)
+{
+    const int sample = static_cast<int>(value & 0xffu);
+    return ((2 * variation * sample + 127) / 255) - variation;
+}
+
+QRgb variedRgb(const QColor& base, quint32 value, int variation)
+{
+    const int red = std::clamp(
+      base.red() + channelDelta(value, variation), 0, 255);
+    const int green = std::clamp(
+      base.green() + channelDelta(value >> 8, variation), 0, 255);
+    const int blue = std::clamp(
+      base.blue() + channelDelta(value >> 16, variation), 0, 255);
+    return qRgb(red, green, blue);
+}
+
+void fillPhysicalRect(QImage& image, const QRect& rect, QRgb value)
+{
+    const int left = rect.x();
+    const int right = rect.x() + rect.width();
+    const int bottom = rect.y() + rect.height();
+
+    for (int y = rect.y(); y < bottom; ++y) {
+        auto* row = reinterpret_cast<QRgb*>(image.scanLine(y));
+        std::fill(row + left, row + right, value);
+    }
+}
+
+bool copyRgb32Image(QImage& destination,
+                    const QPoint& destinationTopLeft,
+                    const QImage& source)
+{
+    const QRect destinationRect(destinationTopLeft, source.size());
+    if (destination.format() != QImage::Format_RGB32 ||
+        source.format() != QImage::Format_RGB32 || source.isNull() ||
+        !destination.rect().contains(destinationRect)) {
+        return false;
+    }
+
+    for (int y = 0; y < source.height(); ++y) {
+        const auto* sourceRow =
+          reinterpret_cast<const QRgb*>(source.constScanLine(y));
+        auto* destinationRow = reinterpret_cast<QRgb*>(
+          destination.scanLine(destinationTopLeft.y() + y));
+        std::copy_n(sourceRow,
+                    source.width(),
+                    destinationRow + destinationTopLeft.x());
+    }
+    return true;
+}
+
+bool copyBand(QImage& destination,
+              const QImage& sourceComposite,
+              const QRect& band)
+{
+    if (band.isEmpty()) {
+        return true;
+    }
+
+    // Extract only this allowed band before format conversion. Neither the
+    // converter nor the scanline copier is ever given a target pixel.
+    QImage sourceBand = sourceComposite.copy(band);
+    if (sourceBand.isNull()) {
+        return false;
+    }
+    sourceBand = sourceBand.convertToFormat(QImage::Format_RGB32);
+    if (sourceBand.isNull() || sourceBand.size() != band.size()) {
+        return false;
+    }
+    sourceBand.setDevicePixelRatio(1.0);
+    return copyRgb32Image(destination, band.topLeft(), sourceBand);
+}
+
+bool copyOutsideBands(QImage& destination,
+                      const QImage& sourceComposite,
+                      const QRect& target)
+{
+    const int width = destination.width();
+    const int height = destination.height();
+    const int targetRight = target.x() + target.width();
+    const int targetBottom = target.y() + target.height();
+
+    const QRect topBand(0, 0, width, target.y());
+    const QRect bottomBand(
+      0, targetBottom, width, height - targetBottom);
+    const QRect leftBand(0, target.y(), target.x(), target.height());
+    const QRect rightBand(targetRight,
+                          target.y(),
+                          width - targetRight,
+                          target.height());
+
+    // These four rectangles are non-overlapping and are the exact complement
+    // of target. No call below names any source pixel inside target.
+    return copyBand(destination, sourceComposite, topBand) &&
+           copyBand(destination, sourceComposite, bottomBand) &&
+           copyBand(destination, sourceComposite, leftBand) &&
+           copyBand(destination, sourceComposite, rightBand);
+}
+
+void drawSyntheticPixelation(QImage& destination,
+                             const QRect& target,
+                             const QColor& base,
+                             qreal devicePixelRatio,
+                             const SecureRedactionProcessor::Options& options)
+{
+    const int maxBlockSize = std::max(target.width(), target.height());
+    const qreal requestedBlockSize =
+      std::max(1, options.pixelBlockSize) * devicePixelRatio;
+    const int blockSize = std::max(
+      1,
+      static_cast<int>(std::ceil(std::min<qreal>(requestedBlockSize,
+                                                maxBlockSize))));
+    const int variation =
+      std::clamp(options.variation, 0, MAX_VARIATION);
+    const int targetRight = target.x() + target.width();
+    const int targetBottom = target.y() + target.height();
+
+    int blockY = 0;
+    for (int y = target.y(); y < targetBottom; ++blockY) {
+        const int blockHeight = std::min(blockSize, targetBottom - y);
+        int blockX = 0;
+        for (int x = target.x(); x < targetRight; ++blockX) {
+            const int blockWidth = std::min(blockSize, targetRight - x);
+            const quint32 pattern = mixCoordinates(
+              static_cast<quint32>(blockX),
+              static_cast<quint32>(blockY),
+              options.patternSeed);
+            fillPhysicalRect(destination,
+                             QRect(x, y, blockWidth, blockHeight),
+                             variedRgb(base, pattern, variation));
+            x += blockWidth;
+        }
+        y += blockHeight;
+    }
+}
+
+int interpolateChannel(int from, int to, int weight)
+{
+    const qint64 weighted =
+      static_cast<qint64>(from) * (WEIGHT_SCALE - weight) +
+      static_cast<qint64>(to) * weight;
+    return static_cast<int>((weighted + WEIGHT_SCALE / 2) / WEIGHT_SCALE);
+}
+
+void drawSyntheticSoftCover(
+  QImage& destination,
+  const QRect& target,
+  const QColor& base,
+  const SecureRedactionProcessor::Options& options)
+{
+    const int variation =
+      std::clamp(options.variation, 0, MAX_VARIATION);
+    const QRgb topLeft =
+      variedRgb(base, mixCoordinates(0, 0, options.patternSeed), variation);
+    const QRgb topRight =
+      variedRgb(base, mixCoordinates(1, 0, options.patternSeed), variation);
+    const QRgb bottomLeft =
+      variedRgb(base, mixCoordinates(0, 1, options.patternSeed), variation);
+    const QRgb bottomRight =
+      variedRgb(base, mixCoordinates(1, 1, options.patternSeed), variation);
+
+    const int horizontalDivisor = std::max(1, target.width() - 1);
+    const int verticalDivisor = std::max(1, target.height() - 1);
+    const int targetRight = target.x() + target.width();
+    const int targetBottom = target.y() + target.height();
+
+    for (int y = target.y(); y < targetBottom; ++y) {
+        const int relativeY = y - target.y();
+        const int verticalWeight = static_cast<int>(
+          static_cast<qint64>(relativeY) * WEIGHT_SCALE / verticalDivisor);
+        auto* row = reinterpret_cast<QRgb*>(destination.scanLine(y));
+
+        for (int x = target.x(); x < targetRight; ++x) {
+            const int relativeX = x - target.x();
+            const int horizontalWeight = static_cast<int>(
+              static_cast<qint64>(relativeX) * WEIGHT_SCALE /
+              horizontalDivisor);
+
+            const int topRed = interpolateChannel(
+              qRed(topLeft), qRed(topRight), horizontalWeight);
+            const int topGreen = interpolateChannel(
+              qGreen(topLeft), qGreen(topRight), horizontalWeight);
+            const int topBlue = interpolateChannel(
+              qBlue(topLeft), qBlue(topRight), horizontalWeight);
+            const int bottomRed = interpolateChannel(
+              qRed(bottomLeft), qRed(bottomRight), horizontalWeight);
+            const int bottomGreen = interpolateChannel(
+              qGreen(bottomLeft), qGreen(bottomRight), horizontalWeight);
+            const int bottomBlue = interpolateChannel(
+              qBlue(bottomLeft), qBlue(bottomRight), horizontalWeight);
+
+            row[x] = qRgb(interpolateChannel(
+                            topRed, bottomRed, verticalWeight),
+                          interpolateChannel(
+                            topGreen, bottomGreen, verticalWeight),
+                          interpolateChannel(
+                            topBlue, bottomBlue, verticalWeight));
+        }
+    }
+}
+
+bool copyCover(QImage& destination,
+               const QRect& target,
+               const QImage& cover)
+{
+    if (cover.size() != target.size() || target.isEmpty()) {
+        return false;
+    }
+    return copyRgb32Image(destination, target.topLeft(), cover);
+}
+
+}
+
+QRect SecureRedactionProcessor::logicalToPhysicalRect(
+  const QRect& logicalRect,
+  qreal devicePixelRatio,
+  const QSize& physicalSize)
+{
+    if (logicalRect.width() <= 0 || logicalRect.height() <= 0 ||
+        physicalSize.width() <= 0 || physicalSize.height() <= 0 ||
+        !(devicePixelRatio > 0.0) ||
+        !std::isfinite(static_cast<double>(devicePixelRatio))) {
+        return {};
+    }
+
+    // QRect's right()/bottom() are inclusive. This calculation intentionally
+    // uses x + width and y + height so that the API remains half-open.
+    const qreal logicalLeft = static_cast<qreal>(logicalRect.x());
+    const qreal logicalTop = static_cast<qreal>(logicalRect.y());
+    const qreal logicalRight =
+      logicalLeft + static_cast<qreal>(logicalRect.width());
+    const qreal logicalBottom =
+      logicalTop + static_cast<qreal>(logicalRect.height());
+
+    const qreal physicalWidth = static_cast<qreal>(physicalSize.width());
+    const qreal physicalHeight = static_cast<qreal>(physicalSize.height());
+    const qreal clippedLeft = std::clamp(
+      logicalLeft * devicePixelRatio, qreal(0), physicalWidth);
+    const qreal clippedTop = std::clamp(
+      logicalTop * devicePixelRatio, qreal(0), physicalHeight);
+    const qreal clippedRight = std::clamp(
+      logicalRight * devicePixelRatio, qreal(0), physicalWidth);
+    const qreal clippedBottom = std::clamp(
+      logicalBottom * devicePixelRatio, qreal(0), physicalHeight);
+
+    const int left = static_cast<int>(std::floor(clippedLeft));
+    const int top = static_cast<int>(std::floor(clippedTop));
+    const int right = static_cast<int>(std::ceil(clippedRight));
+    const int bottom = static_cast<int>(std::ceil(clippedBottom));
+
+    if (right <= left || bottom <= top) {
+        return {};
+    }
+    return { left, top, right - left, bottom - top };
+}
+
+QImage SecureRedactionProcessor::createCover(
+  const QSize& physicalSize,
+  qreal devicePixelRatio,
+  const Options& options)
+{
+    if (physicalSize.width() <= 0 || physicalSize.height() <= 0 ||
+        !(devicePixelRatio > 0.0) ||
+        !std::isfinite(static_cast<double>(devicePixelRatio))) {
+        return {};
+    }
+
+    const QColor coverColor = opaqueColor(options.coverColor);
+    QImage cover(physicalSize, QImage::Format_RGB32);
+    if (cover.isNull()) {
+        return {};
+    }
+
+    // Initialize the complete allocation before selecting a style. This also
+    // makes an out-of-range enum value fail closed as an opaque solid cover.
+    cover.fill(coverColor.rgb());
+    const QRect completeCover(QPoint(0, 0), physicalSize);
+
+    switch (options.style) {
+        case CoverStyle::Solid:
+            break;
+        case CoverStyle::SyntheticPixelated:
+            drawSyntheticPixelation(cover,
+                                    completeCover,
+                                    coverColor,
+                                    devicePixelRatio,
+                                    options);
+            break;
+        case CoverStyle::SyntheticSoft:
+            drawSyntheticSoftCover(
+              cover, completeCover, coverColor, options);
+            break;
+        default:
+            break;
+    }
+
+    // The buffer dimensions are physical. Keeping DPR at 1 prevents an
+    // implicit second scale when a caller maps it to a physical-derived QRectF.
+    cover.setDevicePixelRatio(1.0);
+    return cover;
+}
+
+SecureRedactionProcessor::Result SecureRedactionProcessor::apply(
+  const QImage& sourceComposite,
+  const QRect& logicalRect,
+  qreal devicePixelRatio)
+{
+    return apply(
+      sourceComposite, logicalRect, devicePixelRatio, Options{});
+}
+
+SecureRedactionProcessor::Result SecureRedactionProcessor::apply(
+  const QImage& sourceComposite,
+  const QRect& logicalRect,
+  qreal devicePixelRatio,
+  const Options& options)
+{
+    if (sourceComposite.isNull()) {
+        return {};
+    }
+
+    const QRect physicalRect = logicalToPhysicalRect(
+      logicalRect, devicePixelRatio, sourceComposite.size());
+    if (physicalRect.isEmpty()) {
+        return {};
+    }
+
+    const QColor cover = opaqueColor(options.coverColor);
+
+    // Allocate instead of converting/copying sourceComposite. The initial fill
+    // makes every byte defined and places an opaque safe value in the target
+    // before any source band is inspected.
+    QImage result(sourceComposite.size(), QImage::Format_RGB32);
+    if (result.isNull()) {
+        return {};
+    }
+    result.fill(cover.rgb());
+
+    if (!copyOutsideBands(result, sourceComposite, physicalRect)) {
+        return {};
+    }
+
+    const QImage generatedCover =
+      createCover(physicalRect.size(), devicePixelRatio, options);
+    if (generatedCover.isNull() ||
+        !copyCover(result, physicalRect, generatedCover)) {
+        return {};
+    }
+
+    // DPR is structural display information, not source image metadata. No
+    // text keys, embedded source profile, or other metadata is copied.
+    result.setDevicePixelRatio(devicePixelRatio);
+    return { std::move(result), physicalRect };
+}
