+CaptureTool::ResizeHandle CaptureWidget::resizeHandleAt(
+  const CaptureTool* tool,
+  const QPoint& pos) const
+{
+    if (!tool || !tool->supportsResize()) {
+        return CaptureTool::ResizeHandle::None;
+    }
+
+    CaptureTool::ResizeHandle closest = CaptureTool::ResizeHandle::None;
+    int closestDistanceSquared =
+      2 * ANNOTATION_RESIZE_HANDLE_RADIUS *
+        ANNOTATION_RESIZE_HANDLE_RADIUS +
+      1;
+    for (const auto handle : ANNOTATION_RESIZE_HANDLES) {
+        const QPoint handlePos = tool->resizeHandlePosition(handle);
+        if (!annotationResizeHandleRect(handlePos).contains(pos)) {
+            continue;
+        }
+
+        const QPoint delta = pos - handlePos;
+        const int distanceSquared =
+          delta.x() * delta.x() + delta.y() * delta.y();
+        if (distanceSquared < closestDistanceSquared) {
+            closest = handle;
+            closestDistanceSquared = distanceSquared;
+        }
+    }
+    return closest;
+}
+
+Qt::CursorShape CaptureWidget::resizeCursorForTool(
+  const CaptureTool* tool) const
+{
+    if (!tool || !tool->supportsResize()) {
+        return Qt::CrossCursor;
+    }
+
+    const QPoint first =
+      tool->resizeHandlePosition(CaptureTool::ResizeHandle::FirstPoint);
+    const QPoint second =
+      tool->resizeHandlePosition(CaptureTool::ResizeHandle::SecondPoint);
+    const QPoint diagonal = second - first;
+    if (diagonal.x() == 0) {
+        return Qt::SizeVerCursor;
+    }
+    if (diagonal.y() == 0) {
+        return Qt::SizeHorCursor;
+    }
+    return (diagonal.x() > 0) == (diagonal.y() > 0)
+             ? Qt::SizeFDiagCursor
+             : Qt::SizeBDiagCursor;
+}
