@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#pragma once
+
+#include "geometricareacandidateprovider.h"
+
+#include <QImage>
+#include <QPixmap>
+
+/**
+ * Finds visible window/card/panel-like rectangles solely from screenshot
+ * pixels. This is the primary provider for Linux, including GNOME Wayland,
+ * where clients intentionally cannot enumerate or inspect other windows.
+ * It does not call active-window APIs, EWMH, or compositor-private protocols.
+ *
+ * The provider takes its own immutable image snapshot at construction. The
+ * caller should construct it from CaptureContext::origScreenshot, never the
+ * annotation-composited screenshot.
+ *
+ * Algorithm summary:
+ *  - map the logical hover point to one physical source pixel with floor();
+ *  - find deterministic local colour-gradient peaks in all four directions;
+ *  - combine those peaks into rectangles containing the hover point;
+ *  - score full straight-edge continuity on all four sides;
+ *  - suppress nearly identical outlines and flag close scores as ambiguous.
+ *
+ * Limits: pixel analysis cannot recover hidden or occluded window geometry,
+ * distinguish semantic windows from similarly shaped content, or find a
+ * border whose inside and outside pixels are visually identical. Rounded and
+ * shadowed rectangles are tolerated by sampling away from corners, but may
+ * produce multiple close candidates; those are intentionally ambiguous.
+ */
+class ScreenshotGeometricAreaCandidateProvider final
+  : public GeometricAreaCandidateProvider
+{
+public:
+    struct Parameters
+    {
+        qreal minimumConfidence = 0.42;
+        qreal ambiguityThreshold = 0.06;
+        int maximumReturnedCandidates = 6;
+        QSizeF minimumLogicalSize = QSizeF(32.0, 24.0);
+
+        // Zero searches to the corresponding screenshot boundary. A positive
+        // value bounds hover work for very large captures.
+        qreal maximumLogicalSearchDistance = 0;
+    };
+
+    explicit ScreenshotGeometricAreaCandidateProvider(
+      const QPixmap& immutableScreenshot);
+    ScreenshotGeometricAreaCandidateProvider(
+      const QPixmap& immutableScreenshot,
+      Parameters parameters);
+    ScreenshotGeometricAreaCandidateProvider(
+      const QImage& immutablePhysicalImage,
+      qreal devicePixelRatio);
+    ScreenshotGeometricAreaCandidateProvider(
+      const QImage& immutablePhysicalImage,
+      qreal devicePixelRatio,
+      Parameters parameters);
+
+    bool isReady() const override;
+    QSize physicalSize() const override;
+    QSizeF logicalSize() const override;
+    qreal devicePixelRatio() const override;
+    GeometricAreaMatch matchAt(
+      const QPointF& logicalPosition) const override;
+
+private:
+    void initialize(const QImage& image, qreal devicePixelRatio);
+
+    QImage m_snapshot;
+    qreal m_devicePixelRatio = 1;
+    Parameters m_parameters;
+};
