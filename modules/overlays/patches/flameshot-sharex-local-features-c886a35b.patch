+bool CaptureWidget::isLassoSelectionMode() const
+{
+    return activeButtonToolType() == CaptureTool::TYPE_LASSO_SELECTION;
+}
+
+void CaptureWidget::beginLassoSelection(const QPoint& pos)
+{
+    clearGeometricAreaCandidate();
+    clearLassoSelectionPath();
+    // Set before the first path segment exists so copy/save/open-app shortcuts
+    // during the gesture cannot fall back to the full screenshot.
+    m_context.selectionPathRequired = true;
+    m_context.selection = {};
+    m_lassoDraftPath.setFillRule(Qt::OddEvenFill);
+    m_lassoDraftPath.moveTo(pos);
+    m_lastLassoPoint = pos;
+    m_lassoPointCount = 1;
+    m_lassoDrawing = true;
+    m_selection->hide();
+    m_buttonHandler->hide();
+    m_panel->setActiveLayer(-1);
+    OverlayMessage::pop();
+    update();
+}
+
+void CaptureWidget::updateLassoSelection(const QPoint& pos)
+{
+    if (!m_lassoDrawing ||
+        (pos - m_lastLassoPoint).manhattanLength() < LASSO_POINT_DISTANCE) {
+        return;
+    }
+    m_lassoDraftPath.lineTo(pos);
+    m_lastLassoPoint = pos;
+    ++m_lassoPointCount;
+    update();
+}
+
+void CaptureWidget::finishLassoSelection(const QPoint& pos)
+{
+    updateLassoSelection(pos);
+    const QPainterPath committed = closedLassoPath(m_lassoDraftPath);
+    const QRect bounds =
+      outwardAlignedRect(committed.boundingRect()).intersected(rect());
+    const bool valid = m_lassoPointCount >= 3 && !bounds.isEmpty() &&
+                       filledPathArea(committed) >= MINIMUM_LASSO_AREA;
+
+    m_lassoDrawing = false;
+    m_lassoDraftPath = {};
+    m_lastLassoPoint = {};
+    m_lassoPointCount = 0;
+    if (!valid) {
+        m_context.selectionPath = {};
+        m_context.selection = {};
+        m_lassoSelectionGeometry = {};
+        m_selection->hide();
+        emit m_selection->geometrySettled();
+        update();
+        return;
+    }
+
+    m_context.selectionPath = committed;
+    m_updatingLassoSelectionGeometry = true;
+    m_selection->show();
+    m_selection->setGeometry(bounds);
+    m_updatingLassoSelectionGeometry = false;
+    m_lassoSelectionGeometry = m_selection->geometry().normalized();
+    emit m_selection->geometrySettled();
+    update();
+}
+
+void CaptureWidget::clearLassoSelectionPath()
+{
+    const bool hadPath = !m_context.selectionPath.isEmpty() ||
+                         !m_lassoDraftPath.isEmpty();
+    m_context.selectionPath = {};
+    m_lassoDraftPath = {};
+    m_lassoSelectionGeometry = {};
+    m_lastLassoPoint = {};
+    m_lassoPointCount = 0;
+    m_lassoDrawing = false;
+    m_updatingLassoSelectionGeometry = false;
+    m_context.selectionPathRequired = false;
+    if (hadPath) {
+        update();
+    }
+}
+
+void CaptureWidget::transformLassoSelection(const QRect& geometry)
+{
+    if (m_context.selectionPath.isEmpty() || geometry.isEmpty()) {
+        m_lassoSelectionGeometry = geometry;
+        return;
+    }
+    if (m_lassoSelectionGeometry.isEmpty()) {
+        m_lassoSelectionGeometry = geometry;
+        return;
+    }
+    if (geometry == m_lassoSelectionGeometry) {
+        return;
+    }
+
+    const qreal horizontalScale =
+      static_cast<qreal>(geometry.width()) /
+      m_lassoSelectionGeometry.width();
+    const qreal verticalScale =
+      static_cast<qreal>(geometry.height()) /
+      m_lassoSelectionGeometry.height();
+    const qreal horizontalOffset =
+      geometry.x() - m_lassoSelectionGeometry.x() * horizontalScale;
+    const qreal verticalOffset =
+      geometry.y() - m_lassoSelectionGeometry.y() * verticalScale;
+    const QTransform transform(horizontalScale,
+                               0,
+                               0,
+                               verticalScale,
+                               horizontalOffset,
+                               verticalOffset);
+    m_context.selectionPath = transform.map(m_context.selectionPath);
+    m_lassoSelectionGeometry = geometry;
+    update();
+}
+
+void CaptureWidget::drawLassoSelection(QPainter& painter) const
