+bool hasTransparentPixels(const QPixmap& capture)
+{
+    const QImage image = capture.toImage();
+    if (image.isNull() || !image.hasAlphaChannel()) {
+        return false;
+    }
+
+    QImage convertedImage;
+    const QImage* scanImage = &image;
+    if (image.format() != QImage::Format_ARGB32 &&
+        image.format() != QImage::Format_ARGB32_Premultiplied) {
+        convertedImage = image.convertToFormat(QImage::Format_ARGB32);
+        scanImage = &convertedImage;
+    }
+
+    for (int y = 0; y < scanImage->height(); ++y) {
+        const auto* pixels =
+          reinterpret_cast<const QRgb*>(scanImage->constScanLine(y));
+        for (int x = 0; x < scanImage->width(); ++x) {
+            if (qAlpha(pixels[x]) < 255) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+#if USE_WAYLAND_CLIPBOARD
+class TransparentPngMimeData : public QMimeData
+{
+public:
+    TransparentPngMimeData(QByteArray pngData, QImage image)
+      : m_pngData(std::move(pngData))
+      , m_image(std::move(image))
+    {}
+
+protected:
+    QStringList formats() const override
+    {
+        return { QStringLiteral("image/png"),
+                 QStringLiteral("application/x-qt-image"),
+                 QStringLiteral("x-kde-force-image-copy") };
+    }
+
+    QVariant retrieveData(const QString& mimeType,
+                          QMetaType type) const override
+    {
+        Q_UNUSED(type)
+        if (mimeType == QLatin1String("image/png")) {
+            return m_pngData;
+        }
+        if (mimeType == QLatin1String("application/x-qt-image")) {
+            return QVariant::fromValue(m_image);
+        }
+        if (mimeType == QLatin1String("x-kde-force-image-copy")) {
+            return QByteArray();
+        }
+        return {};
+    }
+
+private:
+    QByteArray m_pngData;
+    QImage m_image;
+};
+#endif
