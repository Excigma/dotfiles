diff --git a/src/tools/redaction/securerectangletool.cpp b/src/tools/redaction/securerectangletool.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..10b812dbbbd51aa084ff86496428d99006beb37e
--- /dev/null
+++ b/src/tools/redaction/securerectangletool.cpp
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "securerectangletool.h"
+
+#include <QPainter>
+#include <QPixmap>
+
+#include <algorithm>
+#include <cmath>
+
+SecureRectangleTool::SecureRectangleTool(QObject* parent)
+  : AbstractTwoPointTool(parent)
+{
+    m_supportsDiagonalAdj = true;
+}
+
+bool SecureRectangleTool::isValid() const
+{
+    const QRect rect = boundingRect();
+    return rect.width() > 0 && rect.height() > 0;
+}
+
+QRect SecureRectangleTool::boundingRect() const
+{
+    const QPoint first = points().first;
+    const QPoint second = points().second;
+    const int left = std::min(first.x(), second.x());
+    const int top = std::min(first.y(), second.y());
+    const int right = std::max(first.x(), second.x());
+    const int bottom = std::max(first.y(), second.y());
+
+    // Cursor endpoints are exclusive edges. Avoiding QRect::bottomRight()
+    // keeps the logical half-open rectangle unambiguous at fractional DPRs.
+    return { left, top, right - left, bottom - top };
+}
+
+SecureRedactionProcessor::Options SecureRectangleTool::coverOptions() const
+{
+    SecureRedactionProcessor::Options options;
+    options.coverColor = secureRedactionColor();
+    options.pixelBlockSize =
+      std::clamp(secureRedactionStrength(), 2, 64);
+    options.variation =
+      std::clamp(secureRedactionStrength() * 2, 8, 64);
+
+    switch (secureRedactionMode()) {
+        case CaptureTool::SecureRedactionMode::SyntheticPixelated:
+            options.style =
+              SecureRedactionProcessor::CoverStyle::SyntheticPixelated;
+            break;
+        case CaptureTool::SecureRedactionMode::SyntheticSoft:
+            options.style =
+              SecureRedactionProcessor::CoverStyle::SyntheticSoft;
+            break;
+        case CaptureTool::SecureRedactionMode::None:
+        default:
+            // This abstract class should only back secure variants. A broken
+            // descriptor still previews as a fail-closed opaque solid cover.
+            options.style = SecureRedactionProcessor::CoverStyle::Solid;
+            break;
+    }
+    return options;
+}
+
+void SecureRectangleTool::process(QPainter& painter, const QPixmap& pixmap)
+{
+    if (!painter.isActive() || pixmap.isNull() || !isValid()) {
+        return;
+    }
+
+    const qreal devicePixelRatio = pixmap.devicePixelRatioF();
+    if (!(devicePixelRatio > 0.0) ||
+        !std::isfinite(static_cast<double>(devicePixelRatio))) {
+        return;
+    }
+
+    // Only structural properties of pixmap are observed. No pixel data from
+    // the screenshot is converted, copied, sampled, or passed to the cover
+    // generator, including pixels at or near the target boundary.
+    const QRect physicalTarget =
+      SecureRedactionProcessor::logicalToPhysicalRect(
+        boundingRect(), devicePixelRatio, pixmap.size());
+    if (physicalTarget.isEmpty()) {
+        return;
+    }
+
+    const QImage cover = SecureRedactionProcessor::createCover(
+      physicalTarget.size(), devicePixelRatio, coverOptions());
+    if (cover.isNull()) {
+        return;
+    }
+
+    // The conservative floor/ceil conversion can extend by a fractional
+    // logical pixel. Map the exact physical rectangle back to painter space so
+    // every touched device pixel is covered at fractional Wayland scales.
+    const QRectF logicalTarget(
+      physicalTarget.x() / devicePixelRatio,
+      physicalTarget.y() / devicePixelRatio,
+      physicalTarget.width() / devicePixelRatio,
+      physicalTarget.height() / devicePixelRatio);
+
+    painter.save();
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, false);
+    painter.drawImage(logicalTarget, cover, QRectF(cover.rect()));
+    painter.restore();
+}
+
+void SecureRectangleTool::drawSearchArea(QPainter& painter,
+                                         const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    painter.fillRect(boundingRect(), Qt::black);
+}
+
+void SecureRectangleTool::paintMousePreview(
+  QPainter& painter,
+  const CaptureContext& context)
+{
+    Q_UNUSED(painter)
+    Q_UNUSED(context)
+}
+
+void SecureRectangleTool::pressed(CaptureContext& context)
+{
+    Q_UNUSED(context)
+}
