+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "spotlighttool.h"
+
+#include <QPainter>
+#include <QPixmap>
+#include <QtMath>
+
+namespace {
+
+constexpr int MIN_STRENGTH_PERCENT = 45;
+constexpr int MAX_STRENGTH_PERCENT = 90;
+constexpr int MAX_TOOL_SIZE = 50;
+
+}
+
+SpotlightTool::SpotlightTool(QObject* parent)
+  : AbstractTwoPointTool(parent)
+{
+    // Match the existing rectangle convention: holding the adjustment key
+    // constrains the focus region to a square while it is drawn.
+    m_supportsDiagonalAdj = true;
+}
+
+QIcon SpotlightTool::icon(const QColor& background, bool inEditor) const
+{
+    Q_UNUSED(inEditor)
+    // Temporary fallback until Spotlight gets a dedicated icon.
+    return QIcon(iconPath(background) + "square-outline.svg");
+}
+
+QString SpotlightTool::name() const
+{
+    return tr("Spotlight");
+}
+
+QString SpotlightTool::description() const
+{
+    return tr("Dim everything outside a rectangular focus area; use the "
+              "mouse wheel to adjust dim strength");
+}
+
+QRect SpotlightTool::boundingRect() const
+{
+    // Keep selection and drag hit-testing limited to the focus region. The
+    // whole-canvas repaint requirement is reported separately to the caller.
+    return QRect(points().first, points().second).normalized();
+}
+
+CaptureTool::Type SpotlightTool::type() const
+{
+    return CaptureTool::TYPE_SPOTLIGHT;
+}
+
+CaptureTool* SpotlightTool::copy(QObject* parent)
+{
+    auto* tool = new SpotlightTool(parent);
+    copyParams(this, tool);
+    tool->m_canvasRect = m_canvasRect;
+    return tool;
+}
+
+QRectF SpotlightTool::logicalCanvasRect(const QPixmap& pixmap)
+{
+    const qreal reportedDpr = pixmap.devicePixelRatio();
+    const qreal dpr = reportedDpr > 0.0 ? reportedDpr : 1.0;
+    return QRectF(0.0,
+                  0.0,
+                  static_cast<qreal>(pixmap.width()) / dpr,
+                  static_cast<qreal>(pixmap.height()) / dpr);
+}
+
+QRect SpotlightTool::logicalUpdateRect(const QPixmap& pixmap)
+{
+    const QRectF canvas = logicalCanvasRect(pixmap);
+    return QRect(0, 0, qCeil(canvas.width()), qCeil(canvas.height()));
+}
+
+int SpotlightTool::dimAlpha() const
+{
+    // The shared size control ranges from 1 to 50 for ordinary drawing tools.
+    // Map it to a useful 46-90% dim range; the default drawing size therefore
+    // produces a visible spotlight without making the context unreadable.
+    const int strengthPercent =
+      qBound(MIN_STRENGTH_PERCENT,
+             MIN_STRENGTH_PERCENT + qBound(1, size(), MAX_TOOL_SIZE),
+             MAX_STRENGTH_PERCENT);
+    return qRound(strengthPercent * 255.0 / 100.0);
+}
+
+void SpotlightTool::process(QPainter& painter, const QPixmap& pixmap)
+{
+    if (!isValid() || pixmap.isNull()) {
+        return;
+    }
+
+    const QRectF canvas = logicalCanvasRect(pixmap);
+    const QRectF focus = QRectF(boundingRect()).intersected(canvas);
+    if (canvas.isEmpty()) {
+        return;
+    }
+
+    const QColor shade(0, 0, 0, dimAlpha());
+
+    painter.save();
+    // Axis-aligned logical rectangles keep the focus boundary deterministic at
+    // fractional DPR instead of resampling screenshot pixels.
+    painter.setRenderHint(QPainter::Antialiasing, false);
+    painter.setCompositionMode(QPainter::CompositionMode_SourceOver);
+    painter.setPen(Qt::NoPen);
+
+    const auto fillBand = [&painter, &shade](const QRectF& band) {
+        if (band.width() > 0.0 && band.height() > 0.0) {
+            painter.fillRect(band, shade);
+        }
+    };
+
+    if (focus.isEmpty()) {
+        fillBand(canvas);
+    } else {
+        fillBand(QRectF(canvas.left(),
+                        canvas.top(),
+                        canvas.width(),
+                        focus.top() - canvas.top()));
+        fillBand(QRectF(canvas.left(),
+                        focus.bottom(),
+                        canvas.width(),
+                        canvas.bottom() - focus.bottom()));
+        fillBand(QRectF(canvas.left(),
+                        focus.top(),
+                        focus.left() - canvas.left(),
+                        focus.height()));
+        fillBand(QRectF(focus.right(),
+                        focus.top(),
+                        canvas.right() - focus.right(),
+                        focus.height()));
+    }
+
+    painter.restore();
+}
+
+void SpotlightTool::drawSearchArea(QPainter& painter, const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    // Clicking the dimmed surroundings should not steal selection from other
+    // annotations; Spotlight is selected by its focus region or layer entry.
+    painter.fillRect(boundingRect(), Qt::black);
+}
+
+void SpotlightTool::paintMousePreview(QPainter& painter,
+                                      const CaptureContext& context)
+{
+    QRect marker(0, 0, 11, 11);
+    marker.moveCenter(context.mousePos);
+
+    painter.save();
+    painter.setBrush(Qt::NoBrush);
+    painter.setPen(QPen(Qt::black, 3));
+    painter.drawRect(marker);
+    painter.setPen(QPen(Qt::white, 1, Qt::DashLine));
+    painter.drawRect(marker);
+    painter.restore();
+}
+
+QRect SpotlightTool::mousePreviewRect(const CaptureContext& context) const
+{
+    if (isValid() && !m_canvasRect.isEmpty()) {
+        // While drawing, the first valid rectangle must invalidate the entire
+        // canvas so that the outside dimming appears immediately.
+        return m_canvasRect;
+    }
+
+    QRect marker(0, 0, 15, 15);
+    marker.moveCenter(context.mousePos);
+    return marker;
+}
+
