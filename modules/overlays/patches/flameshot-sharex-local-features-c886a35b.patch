+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "textbackgroundconfig.h"
+
+#include <QColorDialog>
+#include <QFormLayout>
+#include <QPushButton>
+#include <QSignalBlocker>
+#include <QSpinBox>
+#include <QVBoxLayout>
+
+TextBackgroundConfig::TextBackgroundConfig(QWidget* parent)
+  : TextConfig(parent)
+  , m_backgroundColor(Qt::black)
+  , m_backgroundColorButton(new QPushButton(this))
+  , m_opacitySpin(new QSpinBox(this))
+  , m_paddingSpin(new QSpinBox(this))
+  , m_cornerRadiusSpin(new QSpinBox(this))
+{
+    auto* form = new QFormLayout();
+
+    m_backgroundColorButton->setToolTip(tr("Choose background colour"));
+    m_backgroundColorButton->setMinimumWidth(48);
+    connect(m_backgroundColorButton,
+            &QPushButton::clicked,
+            this,
+            &TextBackgroundConfig::chooseBackgroundColor);
+    form->addRow(tr("Background:"), m_backgroundColorButton);
+
+    m_opacitySpin->setRange(0, 100);
+    m_opacitySpin->setSuffix(QStringLiteral("%"));
+    connect(m_opacitySpin,
+            qOverload<int>(&QSpinBox::valueChanged),
+            this,
+            &TextBackgroundConfig::backgroundOpacityChanged);
+    form->addRow(tr("Opacity:"), m_opacitySpin);
+
+    m_paddingSpin->setRange(0, 64);
+    connect(m_paddingSpin,
+            qOverload<int>(&QSpinBox::valueChanged),
+            this,
+            &TextBackgroundConfig::paddingChanged);
+    form->addRow(tr("Padding:"), m_paddingSpin);
+
+    m_cornerRadiusSpin->setRange(0, 64);
+    connect(m_cornerRadiusSpin,
+            qOverload<int>(&QSpinBox::valueChanged),
+            this,
+            &TextBackgroundConfig::cornerRadiusChanged);
+    form->addRow(tr("Corner radius:"), m_cornerRadiusSpin);
+
+    auto* rootLayout = qobject_cast<QVBoxLayout*>(layout());
+    Q_ASSERT(rootLayout);
+    rootLayout->addLayout(form);
+    updateColorButton();
+}
+
+void TextBackgroundConfig::setBackgroundColor(const QColor& color)
+{
+    m_backgroundColor = color;
+    updateColorButton();
+}
+
+void TextBackgroundConfig::setBackgroundOpacity(int opacity)
+{
+    const QSignalBlocker blocker(m_opacitySpin);
+    m_opacitySpin->setValue(opacity);
+}
+
+void TextBackgroundConfig::setPadding(int padding)
+{
+    const QSignalBlocker blocker(m_paddingSpin);
+    m_paddingSpin->setValue(padding);
+}
+
+void TextBackgroundConfig::setCornerRadius(int radius)
+{
+    const QSignalBlocker blocker(m_cornerRadiusSpin);
+    m_cornerRadiusSpin->setValue(radius);
+}
+
+void TextBackgroundConfig::chooseBackgroundColor()
+{
+    const QColor color = QColorDialog::getColor(
+      m_backgroundColor, this, tr("Text background colour"));
+    if (!color.isValid()) {
+        return;
+    }
+    setBackgroundColor(color);
+    emit backgroundColorChanged(color);
+}
+
+void TextBackgroundConfig::updateColorButton()
+{
+    m_backgroundColorButton->setStyleSheet(
+      QStringLiteral("QPushButton { background-color: %1; }")
+        .arg(m_backgroundColor.name(QColor::HexRgb)));
+}
