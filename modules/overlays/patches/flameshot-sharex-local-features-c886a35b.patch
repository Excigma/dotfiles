+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#pragma once
+
+#include <QFontMetrics>
+#include <QRect>
+#include <QSize>
+#include <QString>
+
+namespace TextLayout {
+
+inline QSize contentSize(const QFont& font, const QString& text)
+{
+    return QFontMetrics(font).boundingRect(QRect(), 0, text).size();
+}
+
+inline QSize outerSize(const QFont& font, const QString& text, int padding)
+{
+    const int safePadding = qMax(0, padding);
+    return contentSize(font, text) +
+           QSize(safePadding * 2, safePadding * 2);
+}
+
+}
