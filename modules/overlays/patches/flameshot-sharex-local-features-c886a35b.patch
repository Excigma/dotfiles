@@ -3,12 +3,88 @@
 
 #include "capturecontext.h"
 
+#include <QImage>
+#include <QPainter>
+#include <QTransform>
+
+#include <cmath>
+
 // TODO rename
 QPixmap CaptureContext::selectedScreenshotArea() const
 {
-    if (selection.isNull()) {
-        return screenshot;
-    } else {
+    if (selectionPath.isEmpty()) {
+        if (selectionPathRequired) {
+            return {};
+        }
+        if (selection.isNull()) {
+            return screenshot;
+        }
         return screenshot.copy(selection);
     }
+
+    // A committed lasso must never fall back to a full-screen capture. Its
+    // SelectionWidget bounding box is the authoritative physical crop.
+    if (screenshot.isNull() || selection.isEmpty()) {
+        return {};
+    }
+
+    const qreal devicePixelRatio = screenshot.devicePixelRatioF();
+    if (!(devicePixelRatio > 0.0) ||
+        !std::isfinite(static_cast<double>(devicePixelRatio))) {
+        return {};
+    }
+
+    const QRect physicalSelection =
+      selection.intersected(QRect(QPoint(), screenshot.size()));
+    if (physicalSelection.isEmpty()) {
+        return {};
+    }
+
+    QImage masked = screenshot.copy(physicalSelection)
+                      .toImage()
+                      .convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    if (masked.isNull()) {
+        return {};
+    }
+
+    // Work entirely in physical pixels. Resetting DPR while painting avoids
+    // QPainter applying an additional implicit device transform. The explicit
+    // transform maps a logical path point (x, y) to:
+    //   (dpr*x - physicalLeft, dpr*y - physicalTop).
+    masked.setDevicePixelRatio(1.0);
+    QImage mask(masked.size(), QImage::Format_ARGB32_Premultiplied);
+    if (mask.isNull()) {
+        return {};
+    }
+    mask.setDevicePixelRatio(1.0);
+    mask.fill(Qt::transparent);
+
+    QPainter maskPainter(&mask);
+    if (!maskPainter.isActive()) {
+        return {};
+    }
+    maskPainter.setRenderHint(QPainter::Antialiasing);
+    maskPainter.setPen(Qt::NoPen);
+    maskPainter.setBrush(Qt::white);
+    maskPainter.setTransform(QTransform(devicePixelRatio,
+                                        0.0,
+                                        0.0,
+                                        devicePixelRatio,
+                                        -physicalSelection.x(),
+                                        -physicalSelection.y()));
+    maskPainter.drawPath(selectionPath);
+    maskPainter.end();
+
+    QPainter imagePainter(&masked);
+    if (!imagePainter.isActive()) {
+        return {};
+    }
+    imagePainter.setCompositionMode(QPainter::CompositionMode_DestinationIn);
+    imagePainter.drawImage(QPoint(), mask);
+    imagePainter.end();
+
+    masked.setDevicePixelRatio(devicePixelRatio);
+    QPixmap result = QPixmap::fromImage(masked);
+    result.setDevicePixelRatio(devicePixelRatio);
+    return result;
 }
