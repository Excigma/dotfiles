+void CaptureWidget::resetGeometricAreaProvider()
+{
+    clearGeometricAreaCandidate();
+    m_geometricAreaCandidateArmed = false;
+    m_geometricAreaDragCancelled = false;
+    m_armedGeometricAreaCandidate = {};
+    m_lastGeometricAreaQuery = {};
+    m_geometricAreaQueryTimer.invalidate();
+    m_geometricAreaProvider.reset();
+    if (m_context.origScreenshot.isNull()) {
+        return;
+    }
+
+    ScreenshotGeometricAreaCandidateProvider::Parameters parameters;
+    parameters.minimumConfidence =
+      m_config.geometricAreaMinimumConfidence() / 100.0;
+    parameters.ambiguityThreshold =
+      m_config.geometricAreaAmbiguityTolerance() / 100.0;
+    m_geometricAreaProvider =
+      std::make_unique<ScreenshotGeometricAreaCandidateProvider>(
+        m_context.origScreenshot, parameters);
+}
+
+bool CaptureWidget::canSuggestGeometricArea() const
+{
+    return m_geometricAreaProvider && m_geometricAreaProvider->isReady() &&
+           m_selection && !m_selection->isVisible() && m_panel &&
+           m_panel->activeLayerIndex() < 0 && m_colorPicker &&
+           !m_colorPicker->isVisible() && m_activeButton.isNull() &&
+           m_activeTool.isNull() && !m_toolWidget && !m_mouseIsClicked &&
+           !m_secureOutputBlocked;
+}
+
+void CaptureWidget::updateGeometricAreaCandidate(const QPoint& pos)
+{
+    if (!canSuggestGeometricArea()) {
+        clearGeometricAreaCandidate();
+        return;
+    }
+
+    if (m_geometricAreaQueryTimer.isValid() &&
+        m_geometricAreaQueryTimer.elapsed() <
+          GEOMETRIC_AREA_QUERY_INTERVAL_MS &&
+        (pos - m_lastGeometricAreaQuery).manhattanLength() <
+          GEOMETRIC_AREA_QUERY_DISTANCE) {
+        return;
+    }
+    m_lastGeometricAreaQuery = pos;
+    m_geometricAreaQueryTimer.restart();
+
+    const GeometricAreaMatch match =
+      m_geometricAreaProvider->matchAt(QPointF(pos));
+    const GeometricAreaCandidate* suggestion = match.suggestion();
+    const QRect nextCandidate =
+      suggestion
+        ? suggestion->outwardAlignedLogicalRect().intersected(rect())
+        : QRect();
+    if (nextCandidate == m_geometricAreaCandidate) {
+        return;
+    }
+
+    const QRect previous = m_geometricAreaCandidate;
+    m_geometricAreaCandidate = nextCandidate;
+    if (!previous.isEmpty()) {
+        update(paddedUpdateRect(previous));
+    }
+    if (!m_geometricAreaCandidate.isEmpty()) {
+        update(paddedUpdateRect(m_geometricAreaCandidate));
+    }
+}
+
+void CaptureWidget::clearGeometricAreaCandidate()
+{
+    if (m_geometricAreaCandidate.isEmpty()) {
+        return;
+    }
+    const QRect previous = m_geometricAreaCandidate;
+    m_geometricAreaCandidate = {};
+    update(paddedUpdateRect(previous));
+}
+
+bool CaptureWidget::armGeometricAreaCandidate(const QPoint& pos)
+{
+    if (!canSuggestGeometricArea() || m_geometricAreaCandidate.isEmpty() ||
+        !m_geometricAreaCandidate.contains(pos)) {
+        clearGeometricAreaCandidate();
+        m_geometricAreaCandidateArmed = false;
+        m_geometricAreaDragCancelled = false;
+        m_armedGeometricAreaCandidate = {};
+        return false;
+    }
+
+    m_geometricAreaCandidateArmed = true;
+    m_geometricAreaDragCancelled = false;
+    m_armedGeometricAreaCandidate = m_geometricAreaCandidate;
+    return true;
+}
+
+bool CaptureWidget::commitArmedGeometricAreaCandidate(const QPoint& pos)
+{
+    if (!m_geometricAreaCandidateArmed) {
+        return false;
+    }
+
+    const QRect candidate = m_armedGeometricAreaCandidate.intersected(rect());
+    const bool commit = !m_geometricAreaDragCancelled && !candidate.isEmpty() &&
+                        candidate.contains(pos) &&
+                        (pos - m_mousePressedPos).manhattanLength() <=
+                          MOUSE_DISTANCE_TO_START_MOVING;
+    m_geometricAreaCandidateArmed = false;
+    m_geometricAreaDragCancelled = false;
+    m_armedGeometricAreaCandidate = {};
+    clearGeometricAreaCandidate();
+    if (!commit) {
+        return false;
+    }
+
+    m_selection->show();
+    m_selection->setGeometry(candidate);
+    emit m_selection->geometrySettled();
+    update();
+    return true;
+}
+
+void CaptureWidget::drawGeometricAreaCandidate(QPainter& painter) const
+{
+    if (m_geometricAreaCandidate.isEmpty()) {
+        return;
+    }
+
+    const QRect outline = m_geometricAreaCandidate.adjusted(0, 0, -1, -1);
+    painter.save();
+    painter.setClipping(false);
+    painter.setBrush(Qt::NoBrush);
+    painter.setPen(QPen(Qt::black, 4, Qt::SolidLine));
+    painter.drawRect(outline);
+    painter.setPen(QPen(m_uiColor, 2, Qt::DashLine));
+    painter.drawRect(outline);
+    painter.restore();
+}
