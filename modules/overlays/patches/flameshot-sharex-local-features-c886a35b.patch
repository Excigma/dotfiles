@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#pragma once
+
+#include <QPointF>
+#include <QRect>
+#include <QRectF>
+#include <QSize>
+#include <QSizeF>
+#include <QVector>
+
+#include <cmath>
+
+enum class GeometricAreaDetectionSource
+{
+    ScreenshotEdges,
+};
+
+/**
+ * A rectangular area found in the captured image. Results from matchAt()
+ * contain the queried point in half-open coordinates.
+ *
+ * physicalRect uses half-open source-image coordinates. logicalRect is the
+ * exact same rectangle divided by the capture DPR; it may therefore have
+ * fractional edges on fractional-scale Wayland displays.
+ */
+struct GeometricAreaCandidate
+{
+    QRect physicalRect;
+    QRectF logicalRect;
+    qreal confidence = 0;
+    GeometricAreaDetectionSource source =
+      GeometricAreaDetectionSource::ScreenshotEdges;
+
+    /**
+     * Integer widget geometry enclosing logicalRect without dropping any
+     * source pixels. CaptureWidget/SelectionWidget can use this until their
+     * geometry is able to retain QRectF coordinates directly.
+     */
+    QRect outwardAlignedLogicalRect() const
+    {
+        if (logicalRect.isEmpty()) {
+            return {};
+        }
+
+        const int left = static_cast<int>(std::floor(logicalRect.x()));
+        const int top = static_cast<int>(std::floor(logicalRect.y()));
+        const int right = static_cast<int>(
+          std::ceil(logicalRect.x() + logicalRect.width()));
+        const int bottom = static_cast<int>(
+          std::ceil(logicalRect.y() + logicalRect.height()));
+        return { left, top, right - left, bottom - top };
+    }
+};
+
+/**
+ * Candidates are ordered by descending confidence. suggestedCandidate is -1
+ * when the best result is below the confidence threshold or when two results
+ * fall within the provider's ambiguity threshold. This lets hover UI display
+ * alternatives without silently choosing between nested cards/panels.
+ */
+struct GeometricAreaMatch
+{
+    QVector<GeometricAreaCandidate> candidates;
+    int suggestedCandidate = -1;
+    bool ambiguous = false;
+
+    bool hasSuggestion() const
+    {
+        return suggestedCandidate >= 0 &&
+               suggestedCandidate < candidates.size();
+    }
+
+    const GeometricAreaCandidate* suggestion() const
+    {
+        return hasSuggestion() ? &candidates[suggestedCandidate] : nullptr;
+    }
+};
+
+/**
+ * Narrow synchronous interface for future CaptureWidget hover/click wiring.
+ * Implementations must return widget-local logical geometry and must not
+ * mutate the captured image.
+ */
+class GeometricAreaCandidateProvider
+{
+public:
+    virtual ~GeometricAreaCandidateProvider() = default;
+
+    virtual bool isReady() const = 0;
+    virtual QSize physicalSize() const = 0;
+    virtual QSizeF logicalSize() const = 0;
+    virtual qreal devicePixelRatio() const = 0;
+    virtual GeometricAreaMatch matchAt(
+      const QPointF& logicalPosition) const = 0;
+};
