+void ConfigHandler::migrateLocalFeatureButtons()
+{
+    constexpr int currentVersion = 1;
+    const QString versionKey = QStringLiteral("localFeatureToolbarVersion");
+    if (value(versionKey).toInt() >= currentVersion) {
+        return;
+    }
+
+    auto migratedButtons = buttons();
+    const QList<CaptureTool::Type> localFeatureButtons = {
+        CaptureTool::TYPE_CURSOR,
+        CaptureTool::TYPE_SMART_ERASER,
+        CaptureTool::TYPE_TEXT_BACKGROUND,
+        CaptureTool::TYPE_BLUR,
+        CaptureTool::TYPE_SECURE_PIXELATE,
+        CaptureTool::TYPE_SECURE_BLUR,
+        CaptureTool::TYPE_SPOTLIGHT,
+        CaptureTool::TYPE_LASSO_SELECTION,
+    };
+    for (const auto type : localFeatureButtons) {
+        if (!migratedButtons.contains(type)) {
+            migratedButtons.append(type);
+        }
+    }
+    std::sort(migratedButtons.begin(),
+              migratedButtons.end(),
+              [](CaptureTool::Type left, CaptureTool::Type right) {
+                  return CaptureToolButton::getPriorityByButton(left) <
+                         CaptureToolButton::getPriorityByButton(right);
+              });
+    setButtons(migratedButtons);
+    setValue(versionKey, currentVersion);
+}
