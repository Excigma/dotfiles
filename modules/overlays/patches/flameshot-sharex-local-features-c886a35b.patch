+++ b/src/tools/smarteraser/smarterasertool.cpp
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "smarterasertool.h"
+
+#include <QImage>
+
+SmartEraserTool::SmartEraserTool(QObject* parent)
+  : AbstractTwoPointTool(parent)
+{}
+
+QIcon SmartEraserTool::icon(const QColor& background, bool inEditor) const
+{
+    Q_UNUSED(inEditor)
+    return QIcon(iconPath(background) + "colorize.svg");
+}
+
+QString SmartEraserTool::name() const
+{
+    return tr("Smart Eraser");
+}
+
+QString SmartEraserTool::description() const
+{
+    return tr("Sample a colour and replace a rectangular area");
+}
+
+QRect SmartEraserTool::boundingRect() const
+{
+    return QRect(points().first, points().second).normalized();
+}
+
+CaptureTool::Type SmartEraserTool::type() const
+{
+    return CaptureTool::TYPE_SMART_ERASER;
+}
+
+CaptureTool* SmartEraserTool::copy(QObject* parent)
+{
+    auto* tool = new SmartEraserTool(parent);
+    copyParams(this, tool);
+    return tool;
+}
+
+void SmartEraserTool::process(QPainter& painter, const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    painter.fillRect(boundingRect(), color());
+}
+
+void SmartEraserTool::drawSearchArea(QPainter& painter,
+                                     const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    painter.fillRect(boundingRect(), Qt::black);
+}
+
+void SmartEraserTool::drawStart(const CaptureContext& context)
+{
+    AbstractTwoPointTool::drawStart(context);
+
+    const QImage image = context.screenshot.toImage();
+    const qreal dpr = context.screenshot.devicePixelRatio();
+    const QPoint samplePoint(qRound(context.mousePos.x() * dpr),
+                             qRound(context.mousePos.y() * dpr));
+    if (image.rect().contains(samplePoint)) {
+        onColorChanged(QColor::fromRgba(image.pixel(samplePoint)));
+    }
+}
+
+void SmartEraserTool::pressed(CaptureContext& context)
+{
+    Q_UNUSED(context)
+}
