+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#pragma once
+
+#include <QColor>
+#include <QImage>
+#include <QRect>
+#include <QSize>
+
+/**
+ * Pure raster processor for irreversible secure redactions.
+ *
+ * The processor deliberately has no editor, undo, clipboard, or filesystem
+ * dependencies. It creates a new opaque image, copies only pixels outside the
+ * redaction rectangle, and synthesizes the covered pixels without consulting
+ * the source rectangle.
+ *
+ * This class does not erase or take ownership of sourceComposite. The caller is
+ * responsible for discarding every source image, preview, and history entry
+ * after a successful result has crossed the editor's confirmation boundary.
+ */
+class SecureRedactionProcessor final
+{
+public:
+    enum class CoverStyle
+    {
+        Solid,
+        SyntheticPixelated,
+        SyntheticSoft,
+    };
+
+    struct Options
+    {
+        CoverStyle style{ CoverStyle::Solid };
+        // Alpha is intentionally ignored; secure covers are always opaque.
+        QColor coverColor{ 36, 36, 36 };
+        // Block size is expressed in logical pixels and scaled by the DPR.
+        int pixelBlockSize{ 12 };
+        // Maximum per-channel synthetic variation, clamped to [0, 96].
+        int variation{ 24 };
+        // A caller may vary the pattern, but it is never derived from pixels.
+        quint32 patternSeed{ 0x5ec0a11u };
+    };
+
+    struct Result
+    {
+        QImage image;
+        QRect physicalRect;
+
+        [[nodiscard]] bool isValid() const
+        {
+            return !image.isNull() && !physicalRect.isEmpty();
+        }
+    };
+
+    /**
+     * Convert a logical half-open rectangle [x, x + width) x
+     * [y, y + height) to a physical-pixel rectangle.
+     *
+     * The result covers every physical pixel touched by the logical rectangle
+     * and is clipped to [0, physicalSize.width()) x
+     * [0, physicalSize.height()). Invalid/empty input returns an empty QRect.
+     */
+    [[nodiscard]] static QRect logicalToPhysicalRect(
+      const QRect& logicalRect,
+      qreal devicePixelRatio,
+      const QSize& physicalSize);
+
+    /**
+     * Create only a source-independent redaction cover.
+     *
+     * physicalSize is the exact number of output pixels. devicePixelRatio is
+     * used only to scale logical pattern parameters such as pixelBlockSize;
+     * the returned image itself has DPR 1 so callers can map its physical
+     * pixels explicitly. Every successful image is opaque Format_RGB32 and
+     * every pixel is initialized. Invalid input returns a null image.
+     */
+    [[nodiscard]] static QImage createCover(const QSize& physicalSize,
+                                            qreal devicePixelRatio,
+                                            const Options& options);
+
+    /**
+     * Return a freshly allocated, fully initialized QImage::Format_RGB32 image.
+     *
+     * The target is computed with logicalToPhysicalRect(). Pixels outside it
+     * are copied as four non-overlapping bands. Pixels inside it are generated
+     * solely from Options and target-relative coordinates. On invalid input,
+     * the returned Result is invalid and contains no partial image.
+     */
+    [[nodiscard]] static Result apply(const QImage& sourceComposite,
+                                      const QRect& logicalRect,
+                                      qreal devicePixelRatio);
+    [[nodiscard]] static Result apply(const QImage& sourceComposite,
+                                      const QRect& logicalRect,
+                                      qreal devicePixelRatio,
+                                      const Options& options);
+
+private:
+    SecureRedactionProcessor() = delete;
+};
