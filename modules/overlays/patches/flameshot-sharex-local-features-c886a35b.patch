+
+qreal filledPathArea(const QPainterPath& path)
+{
+    qreal area = 0;
+    const auto polygons = path.toFillPolygons();
+    for (const QPolygonF& polygon : polygons) {
+        qreal signedArea = 0;
+        for (qsizetype index = 0; index < polygon.size(); ++index) {
+            const QPointF& first = polygon[index];
+            const QPointF& second = polygon[(index + 1) % polygon.size()];
+            signedArea += first.x() * second.y() -
+                          second.x() * first.y();
+        }
+        area += std::abs(signedArea) / 2.0;
+    }
+    return area;
+}
+
+QRect outwardAlignedRect(const QRectF& rectangle)
+{
+    if (rectangle.isEmpty()) {
+        return {};
+    }
+    const int left = static_cast<int>(std::floor(rectangle.x()));
+    const int top = static_cast<int>(std::floor(rectangle.y()));
+    const int right = static_cast<int>(
+      std::ceil(rectangle.x() + rectangle.width()));
+    const int bottom = static_cast<int>(
+      std::ceil(rectangle.y() + rectangle.height()));
+    return { left, top, right - left, bottom - top };
+}
