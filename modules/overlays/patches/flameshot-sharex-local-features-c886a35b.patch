+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "screenshotgeometricareacandidateprovider.h"
+
+#include <QPoint>
+#include <QtGlobal>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <utility>
+
+namespace {
+
+enum class EdgeAxis
+{
+    Vertical,
+    Horizontal
+};
+
+struct EdgePeak
+{
+    int position = 0;
+    qreal strength = 0;
+};
+
+constexpr qreal MIN_RAW_PEAK_STRENGTH = 0.012;
+constexpr qreal CONTINUOUS_EDGE_STRENGTH = 0.012;
+constexpr qreal FULL_EDGE_STRENGTH = 0.12;
+constexpr qreal IMAGE_BOUNDARY_EVIDENCE = 0.28;
+constexpr int MAX_EDGE_POSITIONS_PER_DIRECTION = 7;
+constexpr int GLOBAL_STRONG_PEAKS = 4;
+constexpr int MAX_SIDE_SAMPLES = 24;
+
+qreal colorDifference(QRgb first, QRgb second)
+{
+    const int redDifference = qAbs(qRed(first) - qRed(second));
+    const int greenDifference = qAbs(qGreen(first) - qGreen(second));
+    const int blueDifference = qAbs(qBlue(first) - qBlue(second));
+    const int maximumDifference =
+      std::max({ redDifference, greenDifference, blueDifference });
+
+    const int firstLuma =
+      77 * qRed(first) + 150 * qGreen(first) + 29 * qBlue(first);
+    const int secondLuma =
+      77 * qRed(second) + 150 * qGreen(second) + 29 * qBlue(second);
+    const qreal lumaDifference =
+      qAbs(firstLuma - secondLuma) / (255.0 * 256.0);
+
+    // Combining maximum-channel and luma differences retains coloured edges
+    // whose luminance happens to be similar on both sides.
+    return 0.65 * (maximumDifference / 255.0) + 0.35 * lumaDifference;
+}
+
+QRgb pixelAt(const QImage& image, int x, int y)
+{
+    const auto* line =
+      reinterpret_cast<const QRgb*>(image.constScanLine(y));
+    return line[x];
+}
+
+qreal edgeStrength(const QImage& image,
+                   EdgeAxis axis,
+                   int boundary,
+                   int along)
+{
+    if (axis == EdgeAxis::Vertical) {
+        if (boundary <= 0 || boundary >= image.width() || along < 0 ||
+            along >= image.height()) {
+            return 0;
+        }
+
+        const qreal immediate = colorDifference(
+          pixelAt(image, boundary - 1, along),
+          pixelAt(image, boundary, along));
+        qreal broad = immediate;
+        if (boundary >= 2 && boundary + 1 < image.width()) {
+            broad = colorDifference(pixelAt(image, boundary - 2, along),
+                                    pixelAt(image, boundary + 1, along));
+        }
+        return std::max(immediate, broad * 0.85);
+    }
+
+    if (boundary <= 0 || boundary >= image.height() || along < 0 ||
+        along >= image.width()) {
+        return 0;
+    }
+
+    const qreal immediate =
+      colorDifference(pixelAt(image, along, boundary - 1),
+                      pixelAt(image, along, boundary));
+    qreal broad = immediate;
+    if (boundary >= 2 && boundary + 1 < image.height()) {
+        broad = colorDifference(pixelAt(image, along, boundary - 2),
+                                pixelAt(image, along, boundary + 1));
+    }
+    return std::max(immediate, broad * 0.85);
+}
+
+qreal probedEdgeStrength(const QImage& image,
+                         EdgeAxis axis,
+                         int boundary,
+                         int perpendicularPosition,
+                         int probeRadius)
+{
+    const int perpendicularLimit =
+      axis == EdgeAxis::Vertical ? image.height() : image.width();
+    const int step = std::max(1, probeRadius / 2);
+    qreal sum = 0;
+    int samples = 0;
+
+    for (int offset = -probeRadius; offset <= probeRadius; offset += step) {
+        const int along =
+          std::clamp(perpendicularPosition + offset,
+                     0,
+                     perpendicularLimit - 1);
+        sum += edgeStrength(image, axis, boundary, along);
+        ++samples;
+    }
+    return samples > 0 ? sum / samples : 0;
+}
+
+bool samePosition(const QVector<EdgePeak>& peaks,
+                  int position,
+                  int tolerance)
+{
+    return std::any_of(peaks.cbegin(), peaks.cend(), [&](const EdgePeak& peak) {
+        return qAbs(peak.position - position) <= tolerance;
+    });
+}
+
+void appendPeak(QVector<EdgePeak>& selected,
+                const EdgePeak& peak,
+                int tolerance,
+                int maximumCount)
+{
+    if (selected.size() >= maximumCount ||
+        samePosition(selected, peak.position, tolerance)) {
+        return;
+    }
+    selected.append(peak);
+}
+
+QVector<EdgePeak> selectPeaks(QVector<EdgePeak> peaks,
+                              int hoverPosition,
+                              int imageBoundary,
+                              bool includeImageBoundary,
+                              int separation)
+{
+    if (peaks.isEmpty() && !includeImageBoundary) {
+        return {};
+    }
+
+    const QVector<EdgePeak> peaksByPosition = peaks;
+    std::sort(peaks.begin(), peaks.end(), [&](const EdgePeak& first,
+                                               const EdgePeak& second) {
+        if (first.strength != second.strength) {
+            return first.strength > second.strength;
+        }
+        const int firstDistance = qAbs(first.position - hoverPosition);
+        const int secondDistance = qAbs(second.position - hoverPosition);
+        return firstDistance == secondDistance
+                 ? first.position < second.position
+                 : firstDistance < secondDistance;
+    });
+
+    QVector<EdgePeak> selected;
+    selected.reserve(MAX_EDGE_POSITIONS_PER_DIRECTION);
+    const int reservedForBoundary = includeImageBoundary ? 1 : 0;
+    const int nonBoundaryLimit =
+      MAX_EDGE_POSITIONS_PER_DIRECTION - reservedForBoundary;
+
+    for (int index = 0;
+         index < peaks.size() && index < GLOBAL_STRONG_PEAKS;
+         ++index) {
+        appendPeak(selected,
+                   peaks[index],
+                   separation,
+                   nonBoundaryLimit);
+    }
+
+    // Retain the nearest visible edge even when stronger text/icon edges are
+    // present, then add peaks from distinct logarithmic distance bands. This
+    // makes nested card, panel, and outer-window candidates available without
+    // exploding the rectangle combination count.
+    QVector<EdgePeak> byDistance = peaksByPosition;
+    std::sort(byDistance.begin(), byDistance.end(), [&](const EdgePeak& first,
+                                                         const EdgePeak& second) {
+        const int firstDistance = qAbs(first.position - hoverPosition);
+        const int secondDistance = qAbs(second.position - hoverPosition);
+        if (firstDistance != secondDistance) {
+            return firstDistance < secondDistance;
+        }
+        return first.strength == second.strength
+                 ? first.position < second.position
+                 : first.strength > second.strength;
+    });
+    if (!byDistance.isEmpty()) {
+        appendPeak(selected,
+                   byDistance.first(),
+                   separation,
+                   nonBoundaryLimit);
+    }
+
+    std::array<EdgePeak, 24> bandBest{};
+    std::array<bool, 24> hasBand{};
+    for (const EdgePeak& peak : peaksByPosition) {
+        int distance = std::max(1, qAbs(peak.position - hoverPosition));
+        int band = 0;
+        while (distance > 8 && band + 1 < int(bandBest.size())) {
+            distance = (distance + 1) / 2;
+            ++band;
+        }
+        if (!hasBand[band] || peak.strength > bandBest[band].strength ||
+            (peak.strength == bandBest[band].strength &&
+             peak.position < bandBest[band].position)) {
+            bandBest[band] = peak;
+            hasBand[band] = true;
+        }
+    }
+    for (int band = 0;
+         band < int(bandBest.size()) && selected.size() < nonBoundaryLimit;
+         ++band) {
+        if (hasBand[band]) {
+            appendPeak(selected,
+                       bandBest[band],
+                       separation,
+                       nonBoundaryLimit);
+        }
+    }
+
+    if (includeImageBoundary) {
+        appendPeak(selected,
+                   { imageBoundary, IMAGE_BOUNDARY_EVIDENCE },
+                   0,
+                   MAX_EDGE_POSITIONS_PER_DIRECTION);
+    }
+
+    std::sort(selected.begin(), selected.end(), [](const EdgePeak& first,
+                                                    const EdgePeak& second) {
+        return first.position == second.position
+                 ? first.strength > second.strength
+                 : first.position < second.position;
+    });
+    return selected;
+}
+
+QVector<EdgePeak> collectEdgePeaks(const QImage& image,
+                                   EdgeAxis axis,
+                                   int perpendicularPosition,
+                                   int firstBoundary,
+                                   int lastBoundary,
+                                   int hoverPosition,
+                                   int imageBoundary,
+                                   bool includeImageBoundary,
+                                   int probeRadius,
+                                   int separation)
+{
+    QVector<EdgePeak> peaks;
+    if (firstBoundary <= lastBoundary) {
+        qreal previous = probedEdgeStrength(image,
+                                            axis,
+                                            firstBoundary - 1,
+                                            perpendicularPosition,
+                                            probeRadius);
+        qreal current = probedEdgeStrength(image,
+                                           axis,
+                                           firstBoundary,
+                                           perpendicularPosition,
+                                           probeRadius);
+
+        for (int boundary = firstBoundary; boundary <= lastBoundary;
+             ++boundary) {
+            const qreal next = probedEdgeStrength(image,
+                                                  axis,
+                                                  boundary + 1,
+                                                  perpendicularPosition,
+                                                  probeRadius);
+            if (current >= MIN_RAW_PEAK_STRENGTH && current >= previous &&
+                current > next) {
+                peaks.append({ boundary, current });
+            }
+            previous = current;
+            current = next;
+        }
+    }
+
+    return selectPeaks(std::move(peaks),
+                       hoverPosition,
+                       imageBoundary,
+                       includeImageBoundary,
+                       separation);
+}
+
+qreal normalizedEdgeEvidence(qreal strength)
+{
+    return std::clamp(strength / FULL_EDGE_STRENGTH, qreal(0), qreal(1));
+}
+
+qreal sideEvidence(const QImage& image,
+                   EdgeAxis axis,
+                   int boundary,
+                   int rangeStart,
+                   int rangeEnd)
+{
+    const int boundaryLimit =
+      axis == EdgeAxis::Vertical ? image.width() : image.height();
+    if (boundary == 0 || boundary == boundaryLimit) {
+        // A screenshot edge is plausible but deliberately weaker than an
+        // observed line so the full screen does not dominate every query.
+        return IMAGE_BOUNDARY_EVIDENCE;
+    }
+
+    const int length = rangeEnd - rangeStart;
+    if (length <= 0) {
+        return 0;
+    }
+
+    const int cornerInset = std::min(length / 8, 4);
+    const int sampledStart = rangeStart + cornerInset;
+    const int sampledLength = std::max(1, length - 2 * cornerInset);
+    const int sampleCount =
+      std::clamp(sampledLength / 8, 6, MAX_SIDE_SAMPLES);
+
+    qreal evidenceSum = 0;
+    int continuousSamples = 0;
+    for (int sample = 0; sample < sampleCount; ++sample) {
+        const int along = sampledStart +
+                          static_cast<int>(
+                            (qint64(2 * sample + 1) * sampledLength) /
+                            (2 * sampleCount));
+        const int clippedAlong = std::clamp(
+          along,
+          0,
+          axis == EdgeAxis::Vertical ? image.height() - 1
+                                     : image.width() - 1);
+        const qreal strength =
+          edgeStrength(image, axis, boundary, clippedAlong);
+        evidenceSum += normalizedEdgeEvidence(strength);
+        if (strength >= CONTINUOUS_EDGE_STRENGTH) {
+            ++continuousSamples;
+        }
+    }
+
+    const qreal meanEvidence = evidenceSum / sampleCount;
+    const qreal continuity =
+      static_cast<qreal>(continuousSamples) / sampleCount;
+    return 0.65 * meanEvidence + 0.35 * continuity;
+}
+
+qreal rectangleConfidence(const QImage& image,
+                          const EdgePeak& left,
+                          const EdgePeak& right,
+                          const EdgePeak& top,
+                          const EdgePeak& bottom,
+                          const QPoint& hover)
+{
+    const qreal leftEvidence = sideEvidence(image,
+                                            EdgeAxis::Vertical,
+                                            left.position,
+                                            top.position,
+                                            bottom.position);
+    const qreal rightEvidence = sideEvidence(image,
+                                             EdgeAxis::Vertical,
+                                             right.position,
+                                             top.position,
+                                             bottom.position);
+    const qreal topEvidence = sideEvidence(image,
+                                           EdgeAxis::Horizontal,
+                                           top.position,
+                                           left.position,
+                                           right.position);
+    const qreal bottomEvidence = sideEvidence(image,
+                                              EdgeAxis::Horizontal,
+                                              bottom.position,
+                                              left.position,
+                                              right.position);
+
+    const qreal averageSide =
+      (leftEvidence + rightEvidence + topEvidence + bottomEvidence) / 4.0;
+    const qreal weakestSide =
+      std::min({ leftEvidence, rightEvidence, topEvidence, bottomEvidence });
+    const qreal rayEvidence =
+      (normalizedEdgeEvidence(left.strength) +
+       normalizedEdgeEvidence(right.strength) +
+       normalizedEdgeEvidence(top.strength) +
+       normalizedEdgeEvidence(bottom.strength)) /
+      4.0;
+
+    const int width = right.position - left.position;
+    const int height = bottom.position - top.position;
+    const qreal aspectBalance =
+      static_cast<qreal>(std::min(width, height)) / std::max(width, height);
+    const qreal shapeEvidence = 0.5 + 0.5 * std::sqrt(aspectBalance);
+
+    const int nearestEdge =
+      std::min({ hover.x() - left.position,
+                 right.position - hover.x(),
+                 hover.y() - top.position,
+                 bottom.position - hover.y() });
+    const qreal cursorInterior = std::clamp(
+      nearestEdge / (0.08 * std::min(width, height)), qreal(0), qreal(1));
+
+    return std::clamp(0.63 * averageSide + 0.20 * weakestSide +
+                        0.10 * rayEvidence + 0.04 * shapeEvidence +
+                        0.03 * cursorInterior,
+                      qreal(0),
+                      qreal(1));
+}
+
+QRect physicalRect(const EdgePeak& left,
+                   const EdgePeak& right,
+                   const EdgePeak& top,
+                   const EdgePeak& bottom)
+{
+    return { left.position,
+             top.position,
+             right.position - left.position,
+             bottom.position - top.position };
+}
+
+QRectF logicalRect(const QRect& physical, qreal devicePixelRatio)
+{
+    return { physical.x() / devicePixelRatio,
+             physical.y() / devicePixelRatio,
+             physical.width() / devicePixelRatio,
+             physical.height() / devicePixelRatio };
+}
+
+bool nearlySameRectangle(const QRect& first,
+                         const QRect& second,
+                         int tolerance)
+{
+    const int firstRight = first.x() + first.width();
+    const int secondRight = second.x() + second.width();
+    const int firstBottom = first.y() + first.height();
+    const int secondBottom = second.y() + second.height();
+    return qAbs(first.x() - second.x()) <= tolerance &&
+           qAbs(first.y() - second.y()) <= tolerance &&
+           qAbs(firstRight - secondRight) <= tolerance &&
+           qAbs(firstBottom - secondBottom) <= tolerance;
+}
+
+bool candidateOrder(const GeometricAreaCandidate& first,
+                    const GeometricAreaCandidate& second)
+{
+    if (first.confidence != second.confidence) {
+        return first.confidence > second.confidence;
+    }
+
+    const qint64 firstArea =
+      qint64(first.physicalRect.width()) * first.physicalRect.height();
+    const qint64 secondArea =
+      qint64(second.physicalRect.width()) * second.physicalRect.height();
+    if (firstArea != secondArea) {
+        // Prefer the more local surface when the pixel evidence is identical.
+        return firstArea < secondArea;
+    }
+    if (first.physicalRect.x() != second.physicalRect.x()) {
+        return first.physicalRect.x() < second.physicalRect.x();
+    }
+    if (first.physicalRect.y() != second.physicalRect.y()) {
+        return first.physicalRect.y() < second.physicalRect.y();
+    }
+    if (first.physicalRect.width() != second.physicalRect.width()) {
+        return first.physicalRect.width() < second.physicalRect.width();
+    }
+    return first.physicalRect.height() < second.physicalRect.height();
+}
+
+} // namespace
+
+ScreenshotGeometricAreaCandidateProvider::
+  ScreenshotGeometricAreaCandidateProvider(const QPixmap& immutableScreenshot)
+  : ScreenshotGeometricAreaCandidateProvider(immutableScreenshot, Parameters{})
+{}
+
+ScreenshotGeometricAreaCandidateProvider::
+  ScreenshotGeometricAreaCandidateProvider(const QPixmap& immutableScreenshot,
+                                           Parameters parameters)
+  : m_parameters(std::move(parameters))
+{
+    initialize(immutableScreenshot.toImage(),
+               immutableScreenshot.devicePixelRatioF());
+}
+
+ScreenshotGeometricAreaCandidateProvider::
+  ScreenshotGeometricAreaCandidateProvider(
+    const QImage& immutablePhysicalImage,
+    qreal devicePixelRatio)
+  : ScreenshotGeometricAreaCandidateProvider(immutablePhysicalImage,
+                                             devicePixelRatio,
+                                             Parameters{})
+{}
+
+ScreenshotGeometricAreaCandidateProvider::
+  ScreenshotGeometricAreaCandidateProvider(
+    const QImage& immutablePhysicalImage,
+    qreal devicePixelRatio,
+    Parameters parameters)
+  : m_parameters(std::move(parameters))
+{
+    initialize(immutablePhysicalImage, devicePixelRatio);
+}
+
+void ScreenshotGeometricAreaCandidateProvider::initialize(
+  const QImage& image,
+  qreal devicePixelRatio)
+{
+    m_snapshot = {};
+    if (image.isNull() || devicePixelRatio <= 0 ||
+        !std::isfinite(static_cast<double>(devicePixelRatio))) {
+        return;
+    }
+
+    // RGB32 gives edge sampling a fixed four-byte layout. copy() detaches the
+    // provider from subsequent annotation rendering and preserves immutability.
+    m_snapshot = image.convertToFormat(QImage::Format_RGB32).copy();
+    if (m_snapshot.isNull()) {
+        return;
+    }
+    m_devicePixelRatio = devicePixelRatio;
+
+    if (!std::isfinite(
+          static_cast<double>(m_parameters.minimumConfidence))) {
+        m_parameters.minimumConfidence = 0.42;
+    }
+    m_parameters.minimumConfidence = std::clamp(
+      m_parameters.minimumConfidence, qreal(0), qreal(1));
+    if (!std::isfinite(
+          static_cast<double>(m_parameters.ambiguityThreshold))) {
+        m_parameters.ambiguityThreshold = 0.06;
+    }
+    m_parameters.ambiguityThreshold = std::clamp(
+      m_parameters.ambiguityThreshold, qreal(0), qreal(1));
+    m_parameters.maximumReturnedCandidates = std::clamp(
+      m_parameters.maximumReturnedCandidates, 1, 16);
+    const qreal requestedMinimumWidth =
+      m_parameters.minimumLogicalSize.width();
+    const qreal requestedMinimumHeight =
+      m_parameters.minimumLogicalSize.height();
+    m_parameters.minimumLogicalSize.setWidth(
+      std::isfinite(static_cast<double>(requestedMinimumWidth))
+        ? std::max(qreal(1), requestedMinimumWidth)
+        : qreal(32));
+    m_parameters.minimumLogicalSize.setHeight(
+      std::isfinite(static_cast<double>(requestedMinimumHeight))
+        ? std::max(qreal(1), requestedMinimumHeight)
+        : qreal(24));
+    if (!std::isfinite(
+          static_cast<double>(m_parameters.maximumLogicalSearchDistance)) ||
+        m_parameters.maximumLogicalSearchDistance < 0) {
+        m_parameters.maximumLogicalSearchDistance = 0;
+    }
+}
+
+bool ScreenshotGeometricAreaCandidateProvider::isReady() const
+{
+    return !m_snapshot.isNull() && m_devicePixelRatio > 0;
+}
+
+QSize ScreenshotGeometricAreaCandidateProvider::physicalSize() const
+{
+    return m_snapshot.size();
+}
+
+QSizeF ScreenshotGeometricAreaCandidateProvider::logicalSize() const
+{
+    if (!isReady()) {
+        return {};
+    }
+    return { m_snapshot.width() / m_devicePixelRatio,
+             m_snapshot.height() / m_devicePixelRatio };
+}
+
+qreal ScreenshotGeometricAreaCandidateProvider::devicePixelRatio() const
+{
+    return m_devicePixelRatio;
+}
+
+GeometricAreaMatch ScreenshotGeometricAreaCandidateProvider::matchAt(
+  const QPointF& logicalPosition) const
+{
+    GeometricAreaMatch match;
+    if (!isReady() ||
+        !std::isfinite(static_cast<double>(logicalPosition.x())) ||
+        !std::isfinite(static_cast<double>(logicalPosition.y()))) {
+        return match;
+    }
+
+    const qreal physicalX = logicalPosition.x() * m_devicePixelRatio;
+    const qreal physicalY = logicalPosition.y() * m_devicePixelRatio;
+    if (physicalX < 0 || physicalY < 0 ||
+        physicalX >= m_snapshot.width() ||
+        physicalY >= m_snapshot.height()) {
+        return match;
+    }
+
+    // A logical point addresses the physical pixel whose half-open cell
+    // contains it. Never round here: round() skips/duplicates cells at 1.25x,
+    // 1.5x, and other fractional Wayland scale factors.
+    const QPoint hover(static_cast<int>(std::floor(physicalX)),
+                       static_cast<int>(std::floor(physicalY)));
+    const qreal scaledMinimumWidth = std::min<qreal>(
+      std::ceil(m_parameters.minimumLogicalSize.width() *
+                m_devicePixelRatio),
+      m_snapshot.width());
+    const qreal scaledMinimumHeight = std::min<qreal>(
+      std::ceil(m_parameters.minimumLogicalSize.height() *
+                m_devicePixelRatio),
+      m_snapshot.height());
+    const int minimumWidth =
+      std::max(2, static_cast<int>(scaledMinimumWidth));
+    const int minimumHeight =
+      std::max(2, static_cast<int>(scaledMinimumHeight));
+
+    const qreal requestedSearchDistance =
+      m_parameters.maximumLogicalSearchDistance * m_devicePixelRatio;
+    const int maximumSearchDistance =
+      m_parameters.maximumLogicalSearchDistance > 0
+        ? static_cast<int>(std::min<qreal>(
+            std::ceil(requestedSearchDistance),
+            std::max(m_snapshot.width(), m_snapshot.height())))
+        : std::max(m_snapshot.width(), m_snapshot.height());
+
+    const int probeRadius = std::max(
+      1,
+      static_cast<int>(std::min<qreal>(
+        std::ceil(3 * m_devicePixelRatio), qreal(64))));
+    const int separation = std::max(
+      1,
+      static_cast<int>(std::min<qreal>(
+        std::ceil(2 * m_devicePixelRatio), qreal(32))));
+
+    const int leftLimit = static_cast<int>(std::max<qint64>(
+      0, qint64(hover.x()) - maximumSearchDistance));
+    const int rightLimit = static_cast<int>(std::min<qint64>(
+      m_snapshot.width(),
+      qint64(hover.x()) + maximumSearchDistance + 1));
+    const int topLimit = static_cast<int>(std::max<qint64>(
+      0, qint64(hover.y()) - maximumSearchDistance));
+    const int bottomLimit = static_cast<int>(std::min<qint64>(
+      m_snapshot.height(),
+      qint64(hover.y()) + maximumSearchDistance + 1));
+
+    const QVector<EdgePeak> leftEdges = collectEdgePeaks(
+      m_snapshot,
+      EdgeAxis::Vertical,
+      hover.y(),
+      std::max(1, leftLimit),
+      hover.x(),
+      hover.x(),
+      0,
+      leftLimit == 0,
+      probeRadius,
+      separation);
+    const QVector<EdgePeak> rightEdges = collectEdgePeaks(
+      m_snapshot,
+      EdgeAxis::Vertical,
+      hover.y(),
+      hover.x() + 1,
+      std::min(m_snapshot.width() - 1, rightLimit),
+      hover.x(),
+      m_snapshot.width(),
+      rightLimit == m_snapshot.width(),
+      probeRadius,
+      separation);
+    const QVector<EdgePeak> topEdges = collectEdgePeaks(
+      m_snapshot,
+      EdgeAxis::Horizontal,
+      hover.x(),
+      std::max(1, topLimit),
+      hover.y(),
+      hover.y(),
+      0,
+      topLimit == 0,
+      probeRadius,
+      separation);
+    const QVector<EdgePeak> bottomEdges = collectEdgePeaks(
+      m_snapshot,
+      EdgeAxis::Horizontal,
+      hover.x(),
+      hover.y() + 1,
+      std::min(m_snapshot.height() - 1, bottomLimit),
+      hover.y(),
+      m_snapshot.height(),
+      bottomLimit == m_snapshot.height(),
+      probeRadius,
+      separation);
+
+    QVector<GeometricAreaCandidate> rawCandidates;
+    rawCandidates.reserve(leftEdges.size() * rightEdges.size() *
+                          topEdges.size() * bottomEdges.size());
+    for (const EdgePeak& left : leftEdges) {
+        for (const EdgePeak& right : rightEdges) {
+            if (right.position - left.position < minimumWidth) {
+                continue;
+            }
+            for (const EdgePeak& top : topEdges) {
+                for (const EdgePeak& bottom : bottomEdges) {
+                    if (bottom.position - top.position < minimumHeight) {
+                        continue;
+                    }
+
+                    GeometricAreaCandidate candidate;
+                    candidate.physicalRect =
+                      physicalRect(left, right, top, bottom);
+                    candidate.logicalRect =
+                      logicalRect(candidate.physicalRect, m_devicePixelRatio);
+                    candidate.source =
+                      GeometricAreaDetectionSource::ScreenshotEdges;
+                    candidate.confidence = rectangleConfidence(
+                      m_snapshot, left, right, top, bottom, hover);
+                    rawCandidates.append(candidate);
+                }
+            }
+        }
+    }
+
+    std::sort(rawCandidates.begin(), rawCandidates.end(), candidateOrder);
+    const int duplicateTolerance = separation;
+    for (const GeometricAreaCandidate& candidate : rawCandidates) {
+        const bool duplicate = std::any_of(
+          match.candidates.cbegin(),
+          match.candidates.cend(),
+          [&](const GeometricAreaCandidate& existing) {
+              return nearlySameRectangle(existing.physicalRect,
+                                         candidate.physicalRect,
+                                         duplicateTolerance);
+          });
+        if (!duplicate) {
+            match.candidates.append(candidate);
+        }
+        if (match.candidates.size() >=
+            m_parameters.maximumReturnedCandidates) {
+            break;
+        }
+    }
+
+    if (match.candidates.isEmpty() ||
+        match.candidates.first().confidence <
+          m_parameters.minimumConfidence) {
+        return match;
+    }
+
+    if (match.candidates.size() > 1) {
+        const qreal scoreGap = match.candidates[0].confidence -
+                               match.candidates[1].confidence;
+        const bool secondIsPlausible =
+          match.candidates[1].confidence >=
+          m_parameters.minimumConfidence - m_parameters.ambiguityThreshold;
+        match.ambiguous =
+          secondIsPlausible && scoreGap < m_parameters.ambiguityThreshold;
+    }
+    if (!match.ambiguous) {
+        match.suggestedCandidate = 0;
+    }
+    return match;
+}
