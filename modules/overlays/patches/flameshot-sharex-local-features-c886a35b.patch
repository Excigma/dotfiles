+    QPixmap flattened = flattenedEditingState();
+    QImage source = flattened.toImage();
+    const qreal devicePixelRatio = flattened.devicePixelRatioF();
+    SecureRedactionProcessor::Options options;
+    options.coverColor = m_activeTool->secureRedactionColor();
