--- /dev/null
+++ b/src/tools/blur/blurtool.cpp
@@ -0,0 +1,351 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "blurtool.h"
+
+#include <QImage>
+#include <QPainter>
+#include <QPixmap>
+
+#include <algorithm>
+#include <cmath>
+
+namespace {
+
+constexpr int MIN_LOGICAL_BLUR_RADIUS = 2;
+constexpr int MAX_LOGICAL_BLUR_RADIUS = 64;
+constexpr int MAX_PHYSICAL_BLUR_RADIUS = 512;
+
+struct PixelSums
+{
+    qint64 alpha = 0;
+    qint64 red = 0;
+    qint64 green = 0;
+    qint64 blue = 0;
+
+    void add(QRgb pixel)
+    {
+        alpha += qAlpha(pixel);
+        red += qRed(pixel);
+        green += qGreen(pixel);
+        blue += qBlue(pixel);
+    }
+
+    void subtract(QRgb pixel)
+    {
+        alpha -= qAlpha(pixel);
+        red -= qRed(pixel);
+        green -= qGreen(pixel);
+        blue -= qBlue(pixel);
+    }
+
+    QRgb average(int divisor) const
+    {
+        const qint64 rounding = divisor / 2;
+        return qRgba(static_cast<int>((red + rounding) / divisor),
+                     static_cast<int>((green + rounding) / divisor),
+                     static_cast<int>((blue + rounding) / divisor),
+                     static_cast<int>((alpha + rounding) / divisor));
+    }
+};
+
+QRect logicalToPhysicalRect(const QRect& logicalRect,
+                            qreal devicePixelRatio,
+                            const QSize& physicalSize)
+{
+    if (logicalRect.width() <= 0 || logicalRect.height() <= 0 ||
+        physicalSize.width() <= 0 || physicalSize.height() <= 0 ||
+        devicePixelRatio <= 0 ||
+        !std::isfinite(static_cast<double>(devicePixelRatio))) {
+        return {};
+    }
+
+    // QRect::right()/bottom() are inclusive. Calculate the exclusive edges
+    // explicitly so fractional DPRs cover every physical pixel intersected by
+    // the logical half-open rectangle [left, right) x [top, bottom).
+    const qreal logicalLeft = logicalRect.x();
+    const qreal logicalTop = logicalRect.y();
+    const qreal logicalRight =
+      static_cast<qreal>(logicalRect.x()) + logicalRect.width();
+    const qreal logicalBottom =
+      static_cast<qreal>(logicalRect.y()) + logicalRect.height();
+
+    const qreal maxX = physicalSize.width();
+    const qreal maxY = physicalSize.height();
+    const qreal scaledLeft =
+      std::clamp(logicalLeft * devicePixelRatio, qreal(0), maxX);
+    const qreal scaledTop =
+      std::clamp(logicalTop * devicePixelRatio, qreal(0), maxY);
+    const qreal scaledRight =
+      std::clamp(logicalRight * devicePixelRatio, qreal(0), maxX);
+    const qreal scaledBottom =
+      std::clamp(logicalBottom * devicePixelRatio, qreal(0), maxY);
+
+    const int left = static_cast<int>(std::floor(scaledLeft));
+    const int top = static_cast<int>(std::floor(scaledTop));
+    const int right = static_cast<int>(std::ceil(scaledRight));
+    const int bottom = static_cast<int>(std::ceil(scaledBottom));
+
+    if (right <= left || bottom <= top) {
+        return {};
+    }
+    return { left, top, right - left, bottom - top };
+}
+
+QRect expandedAndClipped(const QRect& rect,
+                         int padding,
+                         const QSize& bounds)
+{
+    const qint64 left = std::max<qint64>(0, qint64(rect.x()) - padding);
+    const qint64 top = std::max<qint64>(0, qint64(rect.y()) - padding);
+    const qint64 right = std::min<qint64>(
+      bounds.width(), qint64(rect.x()) + rect.width() + padding);
+    const qint64 bottom = std::min<qint64>(
+      bounds.height(), qint64(rect.y()) + rect.height() + padding);
+
+    if (right <= left || bottom <= top) {
+        return {};
+    }
+    return { static_cast<int>(left),
+             static_cast<int>(top),
+             static_cast<int>(right - left),
+             static_cast<int>(bottom - top) };
+}
+
+int physicalBlurRadius(int toolSize, qreal devicePixelRatio)
+{
+    const int logicalRadius = std::clamp(
+      toolSize, MIN_LOGICAL_BLUR_RADIUS, MAX_LOGICAL_BLUR_RADIUS);
+    const qreal scaledRadius = std::clamp(
+      std::ceil(logicalRadius * devicePixelRatio),
+      qreal(1),
+      static_cast<qreal>(MAX_PHYSICAL_BLUR_RADIUS));
+    return static_cast<int>(scaledRadius);
+}
+
+QImage horizontalBoxBlur(const QImage& source, int radius)
+{
+    QImage output(source.size(), QImage::Format_ARGB32_Premultiplied);
+    if (output.isNull()) {
+        return {};
+    }
+    output.fill(Qt::transparent);
+
+    const int width = source.width();
+    const int height = source.height();
+    const int kernelSize = radius * 2 + 1;
+
+    for (int y = 0; y < height; ++y) {
+        const auto* sourceLine =
+          reinterpret_cast<const QRgb*>(source.constScanLine(y));
+        auto* outputLine = reinterpret_cast<QRgb*>(output.scanLine(y));
+        PixelSums sums;
+
+        for (int offset = -radius; offset <= radius; ++offset) {
+            sums.add(sourceLine[std::clamp(offset, 0, width - 1)]);
+        }
+
+        for (int x = 0; x < width; ++x) {
+            outputLine[x] = sums.average(kernelSize);
+
+            const int removedX = std::clamp(x - radius, 0, width - 1);
+            const int addedX = std::clamp(x + radius + 1, 0, width - 1);
+            sums.subtract(sourceLine[removedX]);
+            sums.add(sourceLine[addedX]);
+        }
+    }
+    return output;
+}
+
+QImage verticalBoxBlur(const QImage& source, int radius)
+{
+    QImage output(source.size(), QImage::Format_ARGB32_Premultiplied);
+    if (output.isNull()) {
+        return {};
+    }
+    output.fill(Qt::transparent);
+
+    const int width = source.width();
+    const int height = source.height();
+    const int kernelSize = radius * 2 + 1;
+
+    for (int x = 0; x < width; ++x) {
+        PixelSums sums;
+        for (int offset = -radius; offset <= radius; ++offset) {
+            const int sourceY = std::clamp(offset, 0, height - 1);
+            const auto* sourceLine =
+              reinterpret_cast<const QRgb*>(source.constScanLine(sourceY));
+            sums.add(sourceLine[x]);
+        }
+
+        for (int y = 0; y < height; ++y) {
+            auto* outputLine = reinterpret_cast<QRgb*>(output.scanLine(y));
+            outputLine[x] = sums.average(kernelSize);
+
+            const int removedY = std::clamp(y - radius, 0, height - 1);
+            const int addedY = std::clamp(y + radius + 1, 0, height - 1);
+            const auto* removedLine =
+              reinterpret_cast<const QRgb*>(source.constScanLine(removedY));
+            const auto* addedLine =
+              reinterpret_cast<const QRgb*>(source.constScanLine(addedY));
+            sums.subtract(removedLine[x]);
+            sums.add(addedLine[x]);
+        }
+    }
+    return output;
+}
+
+QImage blurredTarget(const QImage& source,
+                     const QRect& physicalTarget,
+                     int radius)
+{
+    const QRect sourceArea =
+      expandedAndClipped(physicalTarget, radius, source.size());
+    if (sourceArea.isEmpty()) {
+        return {};
+    }
+
+    // The conversion gives the scanline loops one known layout. Every newly
+    // allocated destination is filled before use and then written completely.
+    const QImage input =
+      source.copy(sourceArea).convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    if (input.isNull()) {
+        return {};
+    }
+
+    const QImage horizontal = horizontalBoxBlur(input, radius);
+    if (horizontal.isNull()) {
+        return {};
+    }
+    const QImage blurred = verticalBoxBlur(horizontal, radius);
+    if (blurred.isNull()) {
+        return {};
+    }
+
+    const QRect relativeTarget = physicalTarget.translated(-sourceArea.topLeft());
+    return blurred.copy(relativeTarget);
+}
+
+} // namespace
+
+BlurTool::BlurTool(QObject* parent)
+  : AbstractTwoPointTool(parent)
+{
+    m_supportsDiagonalAdj = true;
+}
+
+bool BlurTool::isValid() const
+{
+    const QRect rect = boundingRect();
+    return rect.width() > 0 && rect.height() > 0;
+}
+
+QIcon BlurTool::icon(const QColor& background, bool inEditor) const
+{
+    Q_UNUSED(inEditor)
+    // Reuse the closest existing effect icon until a dedicated blur asset is
+    // wired into the shared resources.
+    return QIcon(iconPath(background) + "pixelate.svg");
+}
+
+QString BlurTool::name() const
+{
+    return tr("Blur (Visual Effect)");
+}
+
+QString BlurTool::description() const
+{
+    return tr("Blur a rectangular area as a visual effect. This is not secure "
+              "redaction and must not be used to hide sensitive information.");
+}
+
+QRect BlurTool::boundingRect() const
+{
+    const QPoint first = points().first;
+    const QPoint second = points().second;
+    const int left = std::min(first.x(), second.x());
+    const int top = std::min(first.y(), second.y());
+    const int right = std::max(first.x(), second.x());
+    const int bottom = std::max(first.y(), second.y());
+
+    // Treat the cursor endpoints as exclusive rectangle edges. This avoids
+    // QRect's inclusive bottomRight() convention leaking into DPR conversion.
+    return { left, top, right - left, bottom - top };
+}
+
+CaptureTool::Type BlurTool::type() const
+{
+    return CaptureTool::TYPE_BLUR;
+}
+
+CaptureTool* BlurTool::copy(QObject* parent)
+{
+    auto* tool = new BlurTool(parent);
+    copyParams(this, tool);
+    return tool;
+}
+
+void BlurTool::process(QPainter& painter, const QPixmap& pixmap)
+{
+    if (!painter.isActive() || pixmap.isNull() || !isValid()) {
+        return;
+    }
+
+    const qreal devicePixelRatio = pixmap.devicePixelRatioF();
+    if (devicePixelRatio <= 0 ||
+        !std::isfinite(static_cast<double>(devicePixelRatio))) {
+        return;
+    }
+
+    // This is ordinary annotation input, not a security boundary. Snapshot it
+    // before painting so the blur never samples pixels it has already written.
+    const QImage source = pixmap.toImage();
+    if (source.isNull()) {
+        return;
+    }
+
+    const QRect physicalTarget =
+      logicalToPhysicalRect(boundingRect(), devicePixelRatio, source.size());
+    if (physicalTarget.isEmpty()) {
+        return;
+    }
+
+    const int radius = physicalBlurRadius(size(), devicePixelRatio);
+    const QImage result = blurredTarget(source, physicalTarget, radius);
+    if (result.isNull()) {
+        return;
+    }
+
+    // Drawing to the physical rectangle divided by DPR aligns each result
+    // pixel with its original device pixel, including at fractional Wayland
+    // scale factors. The physical target has already been clipped safely.
+    const QRectF logicalTarget(
+      physicalTarget.x() / devicePixelRatio,
+      physicalTarget.y() / devicePixelRatio,
+      physicalTarget.width() / devicePixelRatio,
+      physicalTarget.height() / devicePixelRatio);
+
+    painter.save();
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, false);
+    painter.drawImage(logicalTarget, result, QRectF(result.rect()));
+    painter.restore();
+}
+
+void BlurTool::drawSearchArea(QPainter& painter, const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    painter.fillRect(boundingRect(), Qt::black);
+}
+
+void BlurTool::paintMousePreview(QPainter& painter,
+                                 const CaptureContext& context)
+{
+    Q_UNUSED(painter)
+    Q_UNUSED(context)
+}
+
+void BlurTool::pressed(CaptureContext& context)
+{
+    Q_UNUSED(context)
+}
