+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Flameshot Contributors
+
+#include "textbackgroundtool.h"
+#include "textbackgroundconfig.h"
+#include "tools/text/textlayout.h"
+#include "tools/text/textwidget.h"
+
+#include <QFontMetrics>
+#include <QPainter>
+
+TextBackgroundTool::TextBackgroundTool(QObject* parent)
+  : TextTool(parent)
+  , m_backgroundColor(Qt::black)
+  , m_backgroundOpacity(75)
+  , m_padding(8)
+  , m_cornerRadius(6)
+  , m_oldAlignment(Qt::AlignLeft)
+  , m_oldSize(0)
+  , m_oldBackgroundOpacity(0)
+  , m_oldPadding(0)
+  , m_oldCornerRadius(0)
+{
+    m_oldFont = m_font;
+    m_oldAlignment = m_alignment;
+    m_oldTextColor = m_color;
+    m_oldBackgroundColor = m_backgroundColor;
+    m_oldSize = m_size;
+    m_oldBackgroundOpacity = m_backgroundOpacity;
+    m_oldPadding = m_padding;
+    m_oldCornerRadius = m_cornerRadius;
+}
+
+QIcon TextBackgroundTool::icon(const QColor& background, bool inEditor) const
+{
+    Q_UNUSED(inEditor)
+    return QIcon(iconPath(background) + "format-text.svg");
+}
+
+QString TextBackgroundTool::name() const
+{
+    return tr("Text with Background");
+}
+
+QString TextBackgroundTool::description() const
+{
+    return tr("Add text on a rounded background");
+}
+
+CaptureTool::Type TextBackgroundTool::type() const
+{
+    return CaptureTool::TYPE_TEXT_BACKGROUND;
+}
+
+QWidget* TextBackgroundTool::widget()
+{
+    QWidget* editor = TextTool::widget();
+    updateEditorBackground();
+    return editor;
+}
+
+QWidget* TextBackgroundTool::configurationWidget()
+{
+    auto* config = new TextBackgroundConfig();
+    setupConfigurationWidget(config);
+
+    connect(config,
+            &TextBackgroundConfig::backgroundColorChanged,
+            this,
+            &TextBackgroundTool::updateBackgroundColor);
+    connect(config,
+            &TextBackgroundConfig::backgroundOpacityChanged,
+            this,
+            &TextBackgroundTool::updateBackgroundOpacity);
+    connect(config,
+            &TextBackgroundConfig::paddingChanged,
+            this,
+            &TextBackgroundTool::updatePadding);
+    connect(config,
+            &TextBackgroundConfig::cornerRadiusChanged,
+            this,
+            &TextBackgroundTool::updateCornerRadius);
+
+    config->setBackgroundColor(m_backgroundColor);
+    config->setBackgroundOpacity(m_backgroundOpacity);
+    config->setPadding(m_padding);
+    config->setCornerRadius(m_cornerRadius);
+    return config;
+}
+
+void TextBackgroundTool::connectBackgroundConfiguration(
+  TextBackgroundTool* target)
+{
+    auto* config = qobject_cast<TextBackgroundConfig*>(m_confW.data());
+    if (config == nullptr) {
+        return;
+    }
+    connect(config,
+            &TextBackgroundConfig::backgroundColorChanged,
+            target,
+            &TextBackgroundTool::updateBackgroundColor);
+    connect(config,
+            &TextBackgroundConfig::backgroundOpacityChanged,
+            target,
+            &TextBackgroundTool::updateBackgroundOpacity);
+    connect(config,
+            &TextBackgroundConfig::paddingChanged,
+            target,
+            &TextBackgroundTool::updatePadding);
+    connect(config,
+            &TextBackgroundConfig::cornerRadiusChanged,
+            target,
+            &TextBackgroundTool::updateCornerRadius);
+}
+
+void TextBackgroundTool::copyParams(const TextBackgroundTool* from,
+                                    TextBackgroundTool* to)
+{
+    TextTool::copyParams(from, to);
+    to->m_backgroundColor = from->m_backgroundColor;
+    to->m_backgroundOpacity = from->m_backgroundOpacity;
+    to->m_padding = from->m_padding;
+    to->m_cornerRadius = from->m_cornerRadius;
+    to->m_oldFont = to->m_font;
+    to->m_oldAlignment = to->m_alignment;
+    to->m_oldTextColor = to->m_color;
+    to->m_oldBackgroundColor = to->m_backgroundColor;
+    to->m_oldSize = to->m_size;
+    to->m_oldBackgroundOpacity = to->m_backgroundOpacity;
+    to->m_oldPadding = to->m_padding;
+    to->m_oldCornerRadius = to->m_cornerRadius;
+}
+
+CaptureTool* TextBackgroundTool::copy(QObject* parent)
+{
+    auto* tool = new TextBackgroundTool(parent);
+    connectConfigurationWidget(tool);
+    connectBackgroundConfiguration(tool);
+    copyParams(this, tool);
+    return tool;
+}
+
+void TextBackgroundTool::process(QPainter& painter, const QPixmap& pixmap)
+{
+    Q_UNUSED(pixmap)
+    if (m_text.isEmpty()) {
+        return;
+    }
+
+    m_textArea.setSize(TextLayout::outerSize(m_font, m_text, m_padding));
+
+    QColor background = m_backgroundColor;
+    background.setAlphaF(m_backgroundOpacity / 100.0);
+
+    painter.save();
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setPen(Qt::NoPen);
+    painter.setBrush(background);
+    if (!editMode()) {
+        painter.drawRoundedRect(m_textArea, m_cornerRadius, m_cornerRadius);
+        painter.setFont(m_font);
+        painter.setPen(m_color);
+        painter.drawText(m_textArea.adjusted(
+                           m_padding, m_padding, -m_padding, -m_padding),
+                         m_alignment,
+                         m_text);
+    }
+    painter.restore();
+
+    if (m_widget != nullptr) {
+        m_widget->setAlignment(m_alignment);
+    }
+}
+
+void TextBackgroundTool::setEditMode(bool editMode)
+{
+    if (editMode) {
+        m_oldFont = m_font;
+        m_oldAlignment = m_alignment;
+        m_oldTextColor = m_color;
+        m_oldBackgroundColor = m_backgroundColor;
+        m_oldSize = m_size;
+        m_oldBackgroundOpacity = m_backgroundOpacity;
+        m_oldPadding = m_padding;
+        m_oldCornerRadius = m_cornerRadius;
+    }
+    TextTool::setEditMode(editMode);
+}
+
+bool TextBackgroundTool::isChanged()
+{
+    return TextTool::isChanged() || m_font != m_oldFont ||
+           m_alignment != m_oldAlignment || m_color != m_oldTextColor ||
+           m_backgroundColor != m_oldBackgroundColor || m_size != m_oldSize ||
+           m_backgroundOpacity != m_oldBackgroundOpacity ||
+           m_padding != m_oldPadding || m_cornerRadius != m_oldCornerRadius;
+}
+
+void TextBackgroundTool::requestRepaint()
+{
+    updateEditorBackground();
+    if (m_widget != nullptr && m_widget->parentWidget() != nullptr) {
+        m_widget->parentWidget()->update();
+    }
+}
+
+void TextBackgroundTool::updateEditorBackground()
+{
