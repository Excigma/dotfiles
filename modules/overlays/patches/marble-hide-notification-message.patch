From 30cd33b51c71cb7177a0454433b0f82f925347bf Mon Sep 17 00:00:00 2001
From: Excigma <git@excigma.xyz>
Date: Tue, 12 Aug 2025 12:27:56 +1200
Subject: [PATCH] feat: hide notification message

---
 theme/gnome-shell/.css/messages.css | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/theme/gnome-shell/.css/messages.css b/theme/gnome-shell/.css/messages.css
index da15d77..6e09ee5 100644
--- a/theme/gnome-shell/.css/messages.css
+++ b/theme/gnome-shell/.css/messages.css
@@ -43,6 +43,22 @@
 	box-shadow: 0 0 15px 0 rgba(0, 0, 0, 0.07);
 }
 
+/* hide message content in OSD */
+.notification-banner .message-body {
+	padding: 0;
+	border-width: 0;
+	min-width: 0;
+	min-height: 0;
+	font-size: 0;
+	opacity: 0;
+}
+
+.notification-banner .message-icon{
+	min-width: 1.5em !important;
+	max-width: 1.5em !important;
+	icon-size: 1.5em !important;
+}
+
 /* messages in menus */
 .message-list .message, 
 .popup-menu-content .message, 
-- 
2.50.1

