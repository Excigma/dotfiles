Subject: [PATCH] feat: hide notification message

---
 theme/gnome-shell/.css/messages.css | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/theme/gnome-shell/.css/messages.css b/theme/gnome-shell/.css/messages.css
index da15d77..6fe76e4 100644
--- a/theme/gnome-shell/.css/messages.css
+++ b/theme/gnome-shell/.css/messages.css
@@ -43,6 +43,16 @@
 	box-shadow: 0 0 15px 0 rgba(0, 0, 0, 0.07);
 }
 
+/* hide message content in OSD */
+.notification-banner .message-body {
+	padding: 0px !important;
+	border-width: 0px !important;
+	min-width: 0px !important;
+	min-height: 0px !important;
+	font-size: 0px !important;
+	opacity: 0 !important;
+}
+
 /* messages in menus */
 .message-list .message, 
 .popup-menu-content .message, 
